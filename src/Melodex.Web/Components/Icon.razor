@* An icon, drawn in the text's colour, for buttons and menus. *@
<svg class="glyph @Class" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Name)
    {
        case "play-next":
            <path d="M4 7h10M4 12h7M4 17h7M15 21v-8M12 16l3-3 3 3" />
            break;
        case "play-last":
            <path d="M4 7h10M4 12h10M4 17h7M17 13v8M14 18l3 3 3-3" />
            break;
        case "star":
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            break;
        case "starred":
            <path class="fill" d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            break;
        case "album":
            <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="2.5" />
            break;
        case "artist":
            <circle cx="12" cy="8" r="4" /><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />
            break;
        case "upgrade":
            <path d="M12 20V6M6 12l6-6 6 6M5 3h14" />
            break;
        case "play":
            <path class="fill" d="M8 5v14l11-7z" />
            break;
        case "listen":
            <path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3" y="14" width="4" height="6" rx="1.5" /><rect x="17" y="14" width="4" height="6" rx="1.5" />
