@code {
    /// <summary>play, listen, get, queue, play-next, play-last, album, artist, upgrade, playlist, more and the rest below.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }
}
