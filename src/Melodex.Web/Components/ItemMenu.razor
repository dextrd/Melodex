@inject Player Player
@inject AuthState Auth
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject Notices Notices
@inject NavigationManager Nav
@inject WishlistStore Wishlist
@inject MarkStore Marks

@*
    Everything for one song, album or artist, behind a "more" button: play it, next or last; start a radio from it; star it; add it to a playlist; get
    it into the library; look for a better copy; move it in its list or take it out; go to its album or artist; or remove it from the library. Right-clicking its row or tile, or pressing
    and holding it on a phone, opens it too (see songmenu.js). Each item shows only where it applies, from what's given.
*@
<span class="song-menu @Class">
    <IconButton Icon="more" On="_open" Title="@($"More for this {What}")" OnClick="Toggle" />
    @if (_open)
    {
        <div class="menu-backdrop" @onclick="Close"></div>
        <div class="menu right" role="menu" @onkeydown="Key">
            @if (Auth.May(UserPermissions.Listen))
            {
                @if (OnPlay.HasDelegate)
                {
                    <button type="button" role="menuitem" @onclick="() => Do(() => OnPlay.InvokeAsync())"><Icon Name="play" />@PlayLabel</button>
                }
                else if (Playing is { Count: > 0 } playing)
                {
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.PlayAsync(playing))"><Icon Name="play" />Play</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.AddAsync(playing, true))"><Icon Name="play-next" />Play next</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.AddAsync(playing, false))"><Icon Name="play-last" />Play last</button>
                }
                else if (ListenTrackId is { } listen && Wishlist.CanFetch)
                {
                    <button type="button" role="menuitem" title="Fetch it to play now, without adding it to your library" @onclick="() => Do(() => Player.ListenAsync(listen, EditionId))"><Icon Name="listen" />Listen now</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.QueueListenAsync(listen, true, EditionId))"><Icon Name="play-next" />Play next</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.QueueListenAsync(listen, false, EditionId))"><Icon Name="play-last" />Play last</button>
                }
                else if (AlbumId is { } album && (AlbumStatus != Melodex.Client.AlbumStatus.Missing || Wishlist.CanFetch))
                {
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.PlayAlbumAsync(album))"><Icon Name="@(AlbumStatus == Melodex.Client.AlbumStatus.Missing ? "listen" : "play")" />@(AlbumStatus == Melodex.Client.AlbumStatus.Missing ? "Listen now" : "Play")</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.QueueAlbumAsync(album, true))"><Icon Name="play-next" />Play next</button>
                    <button type="button" role="menuitem" @onclick="() => Do(() => Player.QueueAlbumAsync(album, false))"><Icon Name="play-last" />Play last</button>
                }
                @if (Radio is { } seed)
                {
                    <button type="button" role="menuitem" title="Play songs like it, without end: some you have, and as your radio settings say, some you don't"
                            @onclick="() => Do(() => Player.StartRadioAsync(seed))"><Icon Name="radio" />Start radio</button>
                }
                @if (Wish is { } wish)
                {
                    var wished = Wishlist.Contains(wish.Id);
                    <button type="button" role="menuitem" disabled="@_busy" @onclick="() => WishAsync(wish, !wished)">
                        <Icon Name="@(wished ? "wished" : "wish")" />@(wished ? "Take it off your wishlist" : "Add to your wishlist")
                    </button>
                }
                @if (Keep is { Count: > 0 })
                {
                    <button type="button" role="menuitem" @onclick="() => { _open = false; _adding = true; }"><Icon Name="playlist" />Add to a playlist…</button>
                }
            }
            @if (Starring is { } star && Auth.May(UserPermissions.Read))
            {
                var starred = Marks.IsStarred(star.Kind, star.Id);
                <button type="button" role="menuitem" @onclick="() => Do(() => Marks.StarAsync(star.Kind, star.Id, !starred))">
                    <Icon Name="@(starred ? "starred" : "star")" />@(starred ? "Take the star off" : "Star")
                </button>
            }
            @if (Auth.May(UserPermissions.Request))
            {
                @if (Get is { } get && Tracker.Find(get.Kind, get.Id) is null)
                {
                    <button type="button" role="menuitem" disabled="@(_busy || ScanStatus.Reading)" @onclick="GetAsync"><Icon Name="get" />@GetLabel</button>
                }
                @if (OnAddToLibrary.HasDelegate)
                {
                    <button type="button" role="menuitem" disabled="@ScanStatus.Reading" title="@(ScanStatus.Reading ? "Wait until the scan has read your files" : null)"
                            @onclick="() => Do(() => OnAddToLibrary.InvokeAsync())"><Icon Name="add" />Add to your library</button>
                }
                @if (OnIgnore.HasDelegate)
                {
                    <button type="button" role="menuitem" @onclick="() => Do(() => OnIgnore.InvokeAsync())"><Icon Name="ignore" />Ignore: don't count it as missing</button>
                }
                @if (UpgradeScope is { } scope)
                {
                    <button type="button" role="menuitem" disabled="@_busy" @onclick="() => UpgradeAsync(scope)">
                        @if (_busy) { <span class="spinner"></span> } else { <Icon Name="upgrade" /> }Look for @(scope.Kind == FormatScopeKind.Track ? "an upgrade" : "upgrades")
                    </button>
                }
            }
            @if (OnDelete.HasDelegate)
            {
                <button type="button" role="menuitem" class="menu-danger" @onclick="() => Do(() => OnDelete.InvokeAsync())"><Icon Name="discard" />Delete now</button>
            }
            @if (OnMove.HasDelegate)
            {
                <hr />
                <button type="button" role="menuitem" disabled="@MoveFirst" @onclick="() => Do(() => OnMove.InvokeAsync(int.MinValue))"><Icon Name="top" />Move to the top</button>
                <button type="button" role="menuitem" disabled="@MoveFirst" @onclick="() => Do(() => OnMove.InvokeAsync(-1))"><Icon Name="up" />Move up</button>
                <button type="button" role="menuitem" disabled="@MoveLast" @onclick="() => Do(() => OnMove.InvokeAsync(1))"><Icon Name="down" />Move down</button>
                <button type="button" role="menuitem" disabled="@MoveLast" @onclick="() => Do(() => OnMove.InvokeAsync(int.MaxValue))"><Icon Name="bottom" />Move to the bottom</button>
            }
            @if (AlbumHref is not null || ArtistHref is not null)
            {
                <hr />
                @if (AlbumHref is not null) { <button type="button" role="menuitem" @onclick="() => Go(AlbumHref)"><Icon Name="album" />Go to album</button> }
                @if (ArtistHref is not null) { <button type="button" role="menuitem" @onclick="() => Go(ArtistHref)"><Icon Name="artist" />Go to artist</button> }
            }
            @if (OnTakeOut.HasDelegate)
            {
                <hr />
                <button type="button" role="menuitem" class="menu-danger" @onclick="() => Do(() => OnTakeOut.InvokeAsync())"><Icon Name="cancel" />@TakeOutLabel</button>
            }
            @if (OnRemove.HasDelegate && Auth.May(UserPermissions.Remove))
            {
                <hr />
                <button type="button" role="menuitem" class="menu-danger" @onclick="() => Do(() => OnRemove.InvokeAsync())"><Icon Name="remove" />Remove from your library…</button>
            }
        </div>
    }
</span>

@if (_adding && Keep is not null)
{
    <AddToPlaylistDialog Name="@Name" Songs="Keep" Art="@((Entry ?? Entries?.FirstOrDefault())?.CoverUrl)" OnClose="() => _adding = false" />
}

@code {
    /// <summary>Plays it where it is, such as a song in the queue, in place of playing or queueing it afresh.</summary>
    [Parameter] public EventCallback OnPlay { get; set; }

    [Parameter] public string PlayLabel { get; set; } = "Play";

    /// <summary>A song you have, as the player has it, to play or queue.</summary>
    [Parameter] public PlayerEntry? Entry { get; set; }

    /// <summary>Songs to play or queue together, such as an album's fetched to listen to; in place of <see cref="Entry"/>.</summary>
    [Parameter] public IReadOnlyList<PlayerEntry>? Entries { get; set; }

    /// <summary>Adds what was fetched to listen to to the library, without fetching it again.</summary>
    [Parameter] public EventCallback OnAddToLibrary { get; set; }

    /// <summary>Deletes what was fetched to listen to.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>A song you don't have, to fetch to listen to (from <see cref="EditionId"/>, if given).</summary>
    [Parameter] public Guid? ListenTrackId { get; set; }

    [Parameter] public Guid? EditionId { get; set; }

    /// <summary>An album to play or queue, fetching the songs you don't have to listen to.</summary>
    [Parameter] public Guid? AlbumId { get; set; }

    /// <summary>How much of the album you have, for what playing it says.</summary>
    [Parameter] public AlbumStatus? AlbumStatus { get; set; }

    /// <summary>What a playlist keeps of it; null for what can't go in one, such as songs only listened to.</summary>
    [Parameter] public IReadOnlyList<PlaylistItem>? Keep { get; set; }

    /// <summary>Its name, for the playlist dialog.</summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>A song or album you don't have, to put on your wishlist or take off it (from <see cref="EditionId"/>, if given).</summary>
    [Parameter] public (RequestKind Kind, Guid Id)? Wish { get; set; }

    /// <summary>What to fetch into the library, while it isn't asked for already.</summary>
    [Parameter] public (RequestKind Kind, Guid Id)? Get { get; set; }

    /// <summary>What the get item says.</summary>
    [Parameter] public string GetLabel { get; set; } = "Get it into your library";

    /// <summary>Stops counting it as missing, where it can be.</summary>
    [Parameter] public EventCallback OnIgnore { get; set; }

    /// <summary>A song's catalogue ID while a file of it is in the library, so a better copy can be looked for.</summary>
    [Parameter] public Guid? UpgradeTrackId { get; set; }

    /// <summary>An album or artist in the library to look for better copies of.</summary>
    [Parameter] public FormatScope? Upgrade { get; set; }

    [Parameter] public string? AlbumHref { get; set; }

    [Parameter] public string? ArtistHref { get; set; }

    /// <summary>
    /// Moves it in the list it's in, such as a playlist: -1 or 1 for a step, <see cref="int.MinValue"/> for the top,
    /// <see cref="int.MaxValue"/> for the bottom.
    /// </summary>
    [Parameter] public EventCallback<int> OnMove { get; set; }

    /// <summary>Whether it's first or last in that list, so it can't go further that way.</summary>
    [Parameter] public bool MoveFirst { get; set; }

    [Parameter] public bool MoveLast { get; set; }

    /// <summary>Takes it out of the list it's in, such as a playlist; it stays in the library.</summary>
    [Parameter] public EventCallback OnTakeOut { get; set; }

    [Parameter] public string TakeOutLabel { get; set; } = "Take it out";

    /// <summary>Takes it out of the library, after asking; for those who may.</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>song, album or artist, for the button's title.</summary>
    [Parameter] public string What { get; set; } = "song";

    [Parameter] public string? Class { get; set; }

    private bool _open, _adding, _busy;

    private IReadOnlyList<PlayerEntry>? Playing => Entries ?? (Entry is null ? null : [Entry]);

    /// <summary>A song, album or artist you have, to star; songs you have and albums in the library are starred without being given.</summary>
    [Parameter] public (MarkKind Kind, Guid Id)? Star { get; set; }

    private (MarkKind Kind, Guid Id)? Starring => Star
        ?? (Entry is { Missing: false, ListenId: null } song && Entries is null ? (MarkKind.Song, song.TrackId)
            : What == "album" && AlbumId is { } album && AlbumStatus is not (null or Melodex.Client.AlbumStatus.Missing) ? (MarkKind.Album, album)
            : null);

    /// <summary>What a radio is started from, when it isn't the song or album given otherwise: an artist, say.</summary>
    [Parameter] public Guid? RadioFrom { get; set; }

    /// <summary>No radio from it: an album of your own files, which no catalogue knows.</summary>
    [Parameter] public bool NoRadio { get; set; }

    // A song of the catalogue's, one to listen to, or an album: a file of your own no catalogue knows has nothing like it to find.
    private Guid? Radio => NoRadio ? null : RadioFrom
        ?? (Entries is null && Entry is { FileId: null } song ? song.TrackId
            : ListenTrackId ?? (What == "album" && Entries is null ? AlbumId : null));

    private FormatScope? UpgradeScope => Upgrade ?? (UpgradeTrackId is { } id ? new FormatScope(FormatScopeKind.Track, id) : null);

    private async Task Toggle()
    {
        // Known before it opens, so it doesn't say the wrong thing first.
        if (!_open && (Wish is not null || ListenTrackId is not null || AlbumId is not null))
            await Wishlist.EnsureLoadedAsync();
        if (!_open && Starring is not null)
            await Marks.EnsureLoadedAsync();
        _open = !_open;
    }

    private async Task WishAsync((RequestKind Kind, Guid Id) wish, bool add)
    {
        _busy = true;
        try
        {
            if (add)
                await Wishlist.AddAsync(wish.Kind, wish.Id, EditionId);
            else
                await Wishlist.RemoveAsync(wish.Id);
            Say(new Notice($"wish:{wish.Id}", NoticeKind.Action, Name is "" ? (add ? "On your wishlist" : "Taken off your wishlist") : Name,
                add ? "On your wishlist, under Library → Wishlist" : "Taken off your wishlist", add ? "library/wishlist" : null, add ? "wished" : "wish", Cover));
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            Failed($"wish:{wish.Id}", add ? "Couldn't add it to your wishlist" : "Couldn't take it off your wishlist", e.Message);
        }
        finally
        {
            _busy = false;
            _open = false;
        }
    }

    private void Close() => _open = false;

    // What the menu's about: its cover, for its notifications.
    private string? Cover => Playing?.FirstOrDefault()?.CoverUrl;

    private void Say(Notice notice, bool always = false) => Notices.Show(notice, always);

    // Something done here went wrong: it's said whatever kinds are turned off.
    private void Failed(string key, string title, string why) =>
        Notices.Show(new Notice(key, NoticeKind.Action, title, why, Icon: "attention", Failed: true), always: true);

    private void Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _open = false;
    }

    private async Task Do(Func<Task> action)
    {
        _open = false;
        await action();
    }

    private void Go(string href)
    {
        _open = false;
        Nav.NavigateTo(href);
    }

    private async Task GetAsync()
    {
        _busy = true;
        try
        {
            var asked = await Tracker.CreateAsync(new CreateRequest(Get!.Value.Kind, Get.Value.Id, EditionId));
            // Another says when it's finished.
            Say(new Notice($"asked:{asked.Id}", NoticeKind.Download, asked.Title, "Asked for: follow it in Activity",
                $"activity/downloads?open={asked.Id}", "get", asked.Target?.CoverUrl ?? Cover));
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            Failed($"asked:{Get!.Value.Id}", "Couldn't ask for it", e.Message);
        }
        finally
        {
            _busy = false;
            _open = false;
        }
    }

    private async Task UpgradeAsync(FormatScope scope)
    {
        _busy = true;
        try
        {
            // Only the upgrades this starts get the notification when they're finished.
            var (found, asked) = await Tracker.WatchNewAsync(() => Api.SearchUpgradesAsync(scope), r => r.Upgrade);
            var one = scope.Kind == FormatScopeKind.Track;
            var key = $"upgrade:{scope.Kind}:{scope.Id}";
            if (found.Upgradable == 0)
                Say(new Notice(key, NoticeKind.Action, one ? "Nothing better to look for" : "Every song is at its cutoff",
                    one ? "It's at its cutoff already" : "So there's nothing better to look for", Icon: "upgrade", Art: Cover), always: true);
            else if (found.Queued == 0)
            {
                // To the one already going, for a song.
                var going = one ? Tracker.Requests.FirstOrDefault(r => r.Upgrade && r.Active && r.TargetId == scope.Id) : null;
                Say(new Notice(key, NoticeKind.Action, "Better copies are being looked for already", "Follow them in Activity",
                    going is not null ? $"activity/downloads?open={going.Id}" : "activity/downloads", "upgrade", Cover), always: true);
            }
            else
            {
                // Another says when they're finished.
                Say(new Notice(key, NoticeKind.Action, one ? "Looking for a better copy" : $"Looking for better copies of {Format.Count(found.Queued, "song", "songs")}",
                    "Follow it in Activity", asked.Count > 0 ? $"activity/downloads?open={asked[0].Id}" : "activity/downloads", "upgrade", Cover));
            }
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            Failed($"upgrade:{scope.Kind}:{scope.Id}", "Couldn't look for an upgrade", e.Message);
        }
        finally
        {
            _busy = false;
            _open = false;
        }
    }
}
