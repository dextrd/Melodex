@using Melodex.Contracts.Plugins
@inject MelodexClient Api

@* Setup's music step: whether Melodex can read the music folder, and connecting a media server. *@
@if (_status is null)
{
    <Loading />
}
else
{
    <div class="card setup-card">
        <h2>Music folder</h2>
        <p>Melodex reads <code>@_status.LibraryPath</code>, the folder your media server reads too.</p>
        @if (!_status.LibraryReadable)
        {
            <p class="error">Melodex can't open it. Check <code>MUSIC_PATH</code> in your compose file, and that the folder can be read by the container.</p>
        }
        else if (_status.AudioFiles == 0)
        {
            <p class="error">It's empty, or holds no music Melodex knows. Check <code>MUSIC_PATH</code> points at your music, or carry on to start from nothing.</p>
        }
        else
        {
            <p>It has @(_status.AudioFiles >= SetupStatus.CountLimit ? $"over {SetupStatus.CountLimit:N0}" : _status.AudioFiles.ToString("N0")) music files.</p>
        }
        <div class="toolbar"><button @onclick="CheckAsync" disabled="@_busy">Check again</button></div>
    </div>

    <div class="card setup-card">
        <h2>Media server</h2>
        <p>The server you listen through. Melodex tells it to scan when music arrives, and finds the music there.</p>
        @if (_status.MediaServer)
        {
            <p><span class="badge owned">Connected</span> Change it under Plugins, the next step.</p>
        }
        else if (_server is { } server)
        {
            @if (_servers.Count > 1)
            {
                <Segmented T="string" Value="server.Manifest.Id" Options="_servers.Select(s => (s.Manifest.Id, s.Manifest.Name, (string?)null)).ToList()"
                           OnChange="Choose" Label="Media server" Disabled="_busy" />
            }
            <p class="muted small">@server.Manifest.Description</p>
            @* Keyed, so another server's form starts afresh. *@
            <SchemaForm @key="server.Manifest.Id" @ref="_form" Schema="server.Manifest.SettingsSchema" />
            @if (_error is not null) { <p class="error">@_error</p> }
            <div class="toolbar">
                <span class="muted small">No media server? Skip this: Melodex still files your music.</span>
                <span class="spacer"></span>
                <button class="primary" disabled="@_busy" @onclick="ConnectAsync">
                    @if (_busy) { <span class="spinner"></span> }Connect
                </button>
            </div>
        }
    </div>
}

@code {
    private const string NavidromeId = "melodex.connector.navidrome";

    private SetupStatus? _status;
    // The media servers Melodex has a plugin for, Navidrome first, and the one being set up.
    private List<AvailablePlugin> _servers = [];
    private AvailablePlugin? _server;
    private SchemaForm? _form;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _servers = (await Api.ListAvailablePluginsAsync())
            .Where(p => p.Manifest is { Type: PluginType.Connector, UsesSettingsOf: null } && p.Problem is null)
            .OrderBy(p => p.Manifest.Id != NavidromeId).ThenBy(p => p.Manifest.Name)
            .ToList();
        _server = _servers.FirstOrDefault();
        await CheckAsync();
    }

    private void Choose(string id)
    {
        _server = _servers.First(s => s.Manifest.Id == id);
        _error = null;
    }

    private async Task CheckAsync()
    {
        _busy = true;
        try
        {
            _status = await Api.GetSetupAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConnectAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var server = _server!.Manifest;
            var added = await Api.AddPluginAsync(new AddPlugin(PluginId: server.Id, Settings: _form!.ToJson()));
            var tested = await Api.TestPluginAsync(added.Id);
            if (tested.Health == HealthStatus.Unhealthy)
            {
                // Keep what was typed, to fix and try again.
                await Api.RemovePluginAsync(added.Id);
                _error = $"Couldn't reach {server.Name}: {tested.HealthMessage}";
            }
            _status = await Api.GetSetupAsync();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
