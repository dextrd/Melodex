@* A playlist's picture: its first album's cover, or four of them in a square once it has that many. *@
@if (Covers.Count >= 4)
{
    @* Shimmering until all four are in, then shown together; the browser's own copies come at once. *@
    <div @key="string.Join('|', Covers.Take(4))" class="cover playlist-mosaic pending @Class" aria-hidden="true">
        @foreach (var url in Covers.Take(4))
        {
            <img src="@url" alt="" loading="lazy" onload="melodexMosaicPart(this)" onerror="melodexMosaicPart(this)" />
        }
    </div>
}
else
{
    <Cover Url="@Covers.FirstOrDefault()" Class="@Class" />
}

@code {
    [Parameter] public IReadOnlyList<string> Covers { get; set; } = [];
    [Parameter] public string? Class { get; set; }
}
