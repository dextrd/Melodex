@*
    A file's quality, coloured by how good it is: red below good, amber for good lossy, green for lossless, and shiny
    gold for hi-res. As a chip in a page's heading, written as it usually is ("FLAC 16/44.1", "MP3 320"); or in lists,
    as a dot that says it when pointed at. For an album, its worst song's, marked when its songs aren't all alike.
*@
@* Nothing, where nothing's known: a file not yet read for it, or that couldn't be. *@
@if (Quality is { Codec: not null } quality)
{
    var label = Mixed ? $"{quality.Label} and up" : quality.Label;
    var details = Mixed ? $"Mixed quality, at worst {quality.Details.ToLowerInvariant()}" : quality.Details;
    if (Dot)
    {
        <span class="quality-dot @Class(quality.Level)" title="@label · @details" role="img" aria-label="@label, @details"></span>
    }
    else
    {
        <span class="badge quality-chip @Class(quality.Level)" title="@details">@label</span>
    }
}

@code {
    [Parameter] public FileQuality? Quality { get; set; }

    /// <summary>A small dot, for lists, rather than a chip.</summary>
    [Parameter] public bool Dot { get; set; }

    /// <summary>Several files' worst quality, of files not all alike.</summary>
    [Parameter] public bool Mixed { get; set; }

    private static string Class(QualityLevel level) => level switch
    {
        QualityLevel.HiRes => "hires",
        QualityLevel.Lossless => "lossless",
        QualityLevel.High or QualityLevel.Good => "good",
        QualityLevel.Fair or QualityLevel.Low => "low",
        _ => "unknown",
    };
}
