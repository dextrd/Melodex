@*
    The missing view's choice for each kind of release: shown in full, for new songs only, or hidden. In Settings for
    every artist, and on an artist's page for theirs.
*@
<div class="card settings-card release-kinds">
    @foreach (var (kind, name, hint) in Kinds)
    {
        var showing = ShowingOf(kind);
        <div class="release-row">
            <span class="release-name">
                @name
                @if (hint is not null)
                {
                    <span class="info" tabindex="0" role="note" aria-label="@hint" data-tip="@hint">i</span>
                }
            </span>
            <Segmented T="ReleaseShowing" Value="showing" Options="ShowingOptions" Label="@name" Class="@($"showing {showing.ToString().ToLowerInvariant()}")"
                       OnChange="value => OnChange.InvokeAsync((kind, value))" />
        </div>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public Func<ReleaseKind, ReleaseShowing> ShowingOf { get; set; } = ReleaseKinds.Default;
    [Parameter] public EventCallback<(ReleaseKind Kind, ReleaseShowing Showing)> OnChange { get; set; }

    /// <summary>Shown under the choices, such as a way back to the defaults.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly IReadOnlyList<(ReleaseShowing, string, string?)> ShowingOptions =
    [
        (ReleaseShowing.Show, "Show", "List it, with every song on it"),
        (ReleaseShowing.NewSongsOnly, "New songs only", "List it only for songs that aren't on a release shown in full or one you have"),
        (ReleaseShowing.Hide, "Hide", "Don't list it"),
    ];

    // One list, the main types first. Other (anything the catalogue gives no main type) keeps whatever it was set to,
    // without a row of its own: it's rare, and hardly anything to choose about.
    private static readonly (ReleaseKind Kind, string Name, string? Hint)[] Kinds =
    [
        (ReleaseKind.Album, "Albums", null),
        (ReleaseKind.Ep, "EPs", null),
        (ReleaseKind.Single, "Singles", null),
        (ReleaseKind.Broadcast, "Broadcasts", "Radio sessions and the like"),
        (ReleaseKind.Live, "Live", null),
        (ReleaseKind.Compilation, "Compilations", "Best-ofs, collections, anthologies"),
        (ReleaseKind.Remix, "Remixes", null),
        (ReleaseKind.Demo, "Demos", null),
        (ReleaseKind.Soundtrack, "Soundtracks", null),
        (ReleaseKind.DjMix, "DJ mixes", null),
        (ReleaseKind.Mixtape, "Mixtapes", "And street albums"),
        (ReleaseKind.Spokenword, "Spoken word", null),
        (ReleaseKind.Interview, "Interviews", null),
        (ReleaseKind.Audiobook, "Audiobooks", null),
        (ReleaseKind.AudioDrama, "Audio dramas", null),
        (ReleaseKind.FieldRecording, "Field recordings", null),
        (ReleaseKind.Bootleg, "Bootlegs", "Releases that never came out officially"),
    ];
}
