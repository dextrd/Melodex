@* A file or song as Review shows it, on each of its tabs, as its suggestions are: its cover, its title, its artist below
   (linked when the library has an artist of that name), and lines about it below that. *@
<div class="suggestion-row">
    @if (Href is not null)
    {
        <a href="@Href" tabindex="-1"><Cover Url="@CoverUrl" /></a>
    }
    else
    {
        <Cover Url="@CoverUrl" />
    }
    <div class="suggestion-text">
        <div class="suggestion">
            <span class="suggestion-title" title="@Title">@if (Href is not null) { <a href="@Href">@Title</a> } else { @Title }</span>
        </div>
        <div class="muted small">
            @if (Artist is null) { <span>unknown artist</span> }
            else if (ArtistHref is not null) { <a href="@ArtistHref">@Artist</a> }
            else { @Artist }
        </div>
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? CoverUrl { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Artist { get; set; }

    /// <summary>The artist's page, when the library has one by that name.</summary>
    [Parameter] public string? ArtistHref { get; set; }

    /// <summary>The song's, album's or artist's page, when it has one.</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A request's or upgrade's title, <c>Glory Box · Portishead</c>, as the title and artist.</summary>
    public static (string Title, string? Artist) Split(string title)
    {
        var at = title.LastIndexOf(" · ", StringComparison.Ordinal);
        return at < 0 ? (title, null) : (title[..at], title[(at + 3)..]);
    }
}
