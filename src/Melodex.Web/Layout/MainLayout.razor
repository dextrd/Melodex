@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject Theme Theme
@inject MelodexClient Api
@inject NavigationManager Nav
@inject NavSections Sections
@using Microsoft.JSInterop
@inject IJSRuntime Js

@* On a phone, the pages go on a line of their own under the rest, as icons with the current page's name. Elsewhere, where the pages' names don't fit on their line, they're icons. *@
<header class="topbar" @ref="_topbar">
    <a class="brand" href=""><Logo />Melodex</a>
    <nav class="nav">
        @SectionLink(NavSection.Library, "Library")
        <NavLink href="activity" title="Activity">@PageIcon("activity")<span class="nav-label">Activity</span></NavLink>
        <NavLink href="downloads" title="Downloads">@PageIcon("downloads")<span class="nav-label">Downloads</span></NavLink>
        @if (Auth.May(UserPermissions.Review))
        {
            <NavLink href="review" title="Review">@PageIcon("review")<span class="nav-label">Review</span></NavLink>
        }
        @SectionLink(NavSection.Search, "Search")
    </nav>
    <span class="spacer"></span>
    <ScanStatus />
    @* Settings sits with the account, as a gear. *@
    <NavLink href="@SettingsHref" Match="NavLinkMatch.Prefix" class="topbar-icon" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
    </NavLink>
    <AccountMenu />
</header>

<main>
    @Body
</main>

@if (Auth.May(UserPermissions.Listen))
{
    <PlayerBar />
}

@code {
    // Library and Search go back to where you were in them; see NavSections.
    private RenderFragment SectionLink(NavSection section, string name) =>
        @<a href="@Sections.Href(section)" class="@(Sections.Current == section ? "active" : null)" aria-current="@(Sections.Current == section ? "page" : null)"
            title="@name" @onclick="() => Sections.Go(section)" @onclick:preventDefault="true">@PageIcon(name.ToLowerInvariant())<span class="nav-label">@name</span></a>;

    private static RenderFragment PageIcon(string page) =>
        @<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
            @switch (page)
            {
                case "library":
                    <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
                    break;
                case "activity":
                    <path d="M3 12h4l3-8 4 16 3-8h4" />
                    break;
                case "downloads":
                    <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
                    break;
                case "review":
                    <path d="M9 11l3 3 8-8" /><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9" />
                    break;
                case "search":
                    <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
                    break;
            }
        </svg>;

    private ElementReference _topbar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("melodexTopbar.watch", _topbar);
    }

    // The first settings tab they may open.
    private string SettingsHref => Auth.May(UserPermissions.Settings) ? "settings"
        : Auth.May(UserPermissions.Users) ? "settings/users"
        : Auth.May(UserPermissions.Keys) ? "settings/api"
        : "settings/appearance";

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += Redraw;
        Sections.Changed += Moved;
        await ApplyThemeAsync();
        await OfferSetupAsync();
    }

    // A new install walks whoever may set it up through the setup steps, until they finish or skip them.
    private async Task OfferSetupAsync()
    {
        if (!Auth.May(UserPermissions.Settings) || Nav.ToBaseRelativePath(Nav.Uri).StartsWith("setup"))
            return;
        try
        {
            if (!(await Api.GetSetupAsync()).Done)
                Nav.NavigateTo("setup");
        }
        catch (MelodexApiException)
        {
            // Not worth stopping the app for: setup is under Settings too.
        }
    }

    // Whoever signed in sees their own theme, here and next time in this browser.
    private async Task ApplyThemeAsync()
    {
        if (Auth.Status?.Appearance is { } appearance)
            await Theme.ApplyAsync(appearance);
    }

    private void Redraw() => InvokeAsync(async () =>
    {
        await ApplyThemeAsync();
        StateHasChanged();
    });

    private void Moved() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.Changed -= Redraw;
        Sections.Changed -= Moved;
    }
}
