@page "/account"
@inject AuthState Auth

<PageTitle>Your account · Melodex</PageTitle>

@* Your own login, what you may do, and your login on each media server: the page version of editing a user. *@
<h1>Your account</h1>
@if (Auth.Status is { } status)
{
    <p class="muted">
        Signed in as <strong>@status.Username</strong>@(status.IsAdmin ? ", the admin, who may do everything." : ".")
    </p>
    <section class="panel" aria-label="Your account">
        <div class="panel-body">
            <UserEditor Self="true" />
        </div>
    </section>
}
