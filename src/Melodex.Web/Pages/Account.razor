@page "/account"
@inject AuthState Auth

<PageTitle>Your account · Melodex</PageTitle>

@* Your own login, what you may do, and your login on each media server: the page version of editing a user. Below
   it, the ListenBrainz and Last.fm accounts your plays are sent to, and your radio settings. *@
<h1>Your account</h1>
@if (Auth.Status is { } status)
{
    <p class="muted">
        Signed in as <strong>@status.Username</strong>@(status.IsAdmin ? ", the admin, who may do everything." : ".")
    </p>
    <section class="panel" aria-label="Your account">
        <div class="panel-body">
            <UserEditor Self="true" />
        </div>
    </section>
    @if (Auth.May(UserPermissions.Listen))
    {
        <h2 id="scrobbling">Scrobbling</h2>
        <p class="muted small">
            Every song you play, here or in a Subsonic player, is kept in your <a href="history">history</a>. Link an account and it's sent there too,
            once it's played for half its length or four minutes; while one can't be reached, plays wait and are sent later.
        </p>
        <section class="panel" aria-label="Scrobbling">
            <div class="panel-body">
                <ScrobbleLinks />
            </div>
        </section>
        <h2 id="radio">Radio</h2>
        <p class="muted small">
            Start a radio from a song, album, artist or playlist, and it plays songs like it without end: none twice, not one you played in the last two
            days while there's enough else, and not the same artist too often. Star what you like and it plays more like it; skip a song in its first
            half minute and no radio plays it to you for 90 days, and its artist comes up less. How many of its songs are ones you don't have is set for
            everyone on the Playback settings page.
        </p>
        <section class="panel" aria-label="Radio">
            <div class="panel-body">
                <RadioSettingsPanel />
            </div>
        </section>
    }
}
