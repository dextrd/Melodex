@page "/albums/{Id:guid}"
@implements IDisposable
@inject PageCache Pages
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject Player Player
@inject Glimpses Glimpses

<PageTitle>@(_album?.Album.Title ?? _glimpse?.Album.Title ?? "Album") · Melodex</PageTitle>

@if (_notFound)
{
    <div class="empty card">That album isn't in the catalogue.</div>
}
else if (_album is null && _glimpse is null)
{
    <Loading />
}
else
{
    // Shown at once from what the list it was opened from knew, filled in as the rest arrives.
    var album = _album?.Album ?? _glimpse!.Album;
    // Buttons that need the whole album wait for it.
    var ready = _album is { Fetching: false } && _switching is null;
    <div class="page-head">
        <Cover Url="@album.CoverUrl" />
        <div>
            <h1>@album.Title</h1>
            <div class="row muted small">
                <a href="artists/@album.ArtistId">@album.ArtistCredit</a>
                <span>@Format.Year(album.FirstReleaseDate)</span>
                <span>@Format.TypeLabel(album.Type)@(album.SecondaryTypes.Count > 0 ? $" · {Format.Secondary(album.SecondaryTypes)}" : "")</span>
                <StatusBadge Album="album.Status" />
                @if (album.HiddenByDefault) { <span class="badge neutral">Hidden by default</span> }
                @if (album.Ignored) { <span class="badge neutral">Ignored</span> }
                <QualityBadge Quality="album.Quality" Mixed="album.MixedQuality" />
                <ProviderIds Ids="album.Ids" Entity="release-group" />
            </div>
            @if (_album is null || _album.Editions.Count > 0 && _album.Tracks.Any(t => t.Status is not TrackStatus.Ignored))
            {
                var tracks = _album?.Tracks ?? [];
                var missing = _album is null ? album.Status is AlbumStatus.Missing or AlbumStatus.Partial : tracks.Any(t => t.Status == TrackStatus.Missing);
                var playLabel = (_album is null ? album.OwnedTracks > 0 : tracks.Any(Owned)) ? "Play" : "Listen now";
                var playHint = missing ? $"{playLabel}: in order, fetching the tracks you don't have to listen to, without adding them to your library" : "Play the album";
                RenderFragment play = @<text>
                    <IconButton Icon="play" Requires="@UserPermissions.Listen" Primary="true" Large="true" Label="@playLabel" Title="@playHint" OnClick="() => Player.PlayAlbumAsync(_album!)" />
                    <QueueButton Large="true" Left="true" Title="@(missing ? "Add to the queue, next or at the end, fetching the tracks you don't have to listen to" : "Add to the queue: next, or at the end")"
                                OnQueue="next => Player.QueueAlbumAsync(_album!, next)" />
                    @if (tracks.Any(Owned))
                    {
                        <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Large="true" Title="Add the songs you have to a playlist"
                                    OnClick="() => _adding = (_album!.Album.Title, _album.Tracks.Where(Owned).Select(t => new PlaylistItem(t.TrackId)).ToList())" />
                    }
                </text>;
                <fieldset class="row album-actions" disabled="@(!ready)" style="margin-top: .5rem;">
                    @if (album.Status is AlbumStatus.Missing or AlbumStatus.Partial)
                    {
                        <FetchButton Kind="RequestKind.Album" Id="album.Id" EditionId="_album?.ShownEditionId" Large="true"
                                     Label="@(album.Status == AlbumStatus.Partial ? "Get missing tracks" : "Get album")"
                                     Hint="@(album.Status == AlbumStatus.Partial ? "Get the missing tracks into your library, as the edition shown below" : "Get the album into your library, as the edition shown below")">
                            @play
                        </FetchButton>
                    }
                    else
                    {
                        @play
                    }
                    @if (album.Status is not AlbumStatus.Missing)
                    {
                        <IconButton Icon="format" Requires="@UserPermissions.Format" Large="true" Label="Format" Title="Rewrite this album's files: their tags, cover and where they live"
                                    OnClick="() => _formatting = true" />
                    }
                    <IconButton Icon="image" Requires="@UserPermissions.Format" Large="true" Label="Cover" Title="Choose the album's cover, from any of its editions or a picture of your own"
                                OnClick="() => _choosingCover = true" />
                </fieldset>
            }
        </div>
    </div>

    @if (_album is { Editions.Count: > 0 } detail)
    {
        <div class="toolbar">
            <label class="small">
                Edition
                <select value="@(_switching ?? detail.ShownEditionId)" disabled="@(_switching is not null)" @onchange="ChangeEditionAsync">
                    @foreach (var edition in detail.Editions)
                    {
                        <option value="@edition.Id">@EditionLabel(edition)</option>
                    }
                </select>
            </label>
            @if (detail.OwnedEditionId is { } owned && owned != (_switching ?? detail.ShownEditionId))
            {
                <button class="link small" @onclick="() => ShowEditionAsync(owned)">Show the edition you have</button>
            }
            @if (detail.Fetching)
            {
                <Loading Inline="true" Text="Checking the catalogue for its editions…" />
            }
        </div>
    }

    @if (_album is null || _switching is not null || _album.Editions.Count == 0 && _album.Fetching)
    {
        @if (_album is null)
        {
            @* Where the editions will be, so the tracks don't move down when they arrive. *@
            <div class="toolbar">
                <label class="small">
                    Edition
                    <select disabled><option>Loading editions…</option></select>
                </label>
            </div>
        }
        @if (_album is { Editions.Count: 0, Fetching: true })
        {
            <Loading Inline="true" Text="Fetching its editions and tracks from the catalogue…" />
        }
        <div class="card">
            <table class="table track-list album-tracks narrow-status" aria-busy="true">
                @TrackHead
                <tbody>
                    @foreach (var slot in Slots())
                    {
                        <tr>
                            <td class="num muted nowrap">@slot.Number</td>
                            @if (slot.Owned is { } track)
                            {
                                <td>
                                    <div class="ellipsis">
                                        <a href="tracks/@track.TrackId" class="plain">@track.Title</a>
                                        @if (track.ArtistCredit != album.ArtistCredit) { <span class="muted small"> · @track.ArtistCredit</span> }
                                    </div>
                                    <div class="muted small ellipsis hide-narrow">@track.Path</div>
                                    <div class="show-narrow"><StatusBadge Track="TrackStatus.Owned" /></div>
                                </td>
                                <td class="num hide-narrow muted">@Format.Duration(track.DurationSeconds)</td>
                                <td class="hide-narrow"><StatusBadge Track="TrackStatus.Owned" /></td>
                            }
                            else
                            {
                                <td><span class="placeholder" style="width: @(7 + slot.Index * 37 % 9)rem"></span></td>
                                <td class="num hide-narrow"><span class="placeholder short"></span></td>
                                <td class="hide-narrow"><span class="placeholder badge-size"></span></td>
                            }
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_album.Editions.Count == 0)
    {
        <div class="empty card">No editions in the catalogue yet.</div>
    }
    else
    {
        <div class="card">
            <table class="table track-list album-tracks narrow-status">
                @TrackHead
                <tbody>
                    @foreach (var track in _album.Tracks)
                    {
                        <tr class="@(track.Status is TrackStatus.Ignored or TrackStatus.Elsewhere ? "dim" : "") @(Player.IsNow(track.TrackId) ? "playing" : "")">
                            <td class="num muted nowrap">@(MultiDisc ? $"{track.Disc}-" : "")@track.Number</td>
                            <td>
                                <div class="ellipsis" title="@track.Title">
                                    <a href="tracks/@track.TrackId" class="plain">@track.Title</a>
                                    <QualityBadge Quality="track.Quality" Dot="true" />
                                    @if (track.ArtistCredit != album.ArtistCredit) { <span class="muted small"> · @track.ArtistCredit</span> }
                                </div>
                                @if (track.FilePath is not null)
                                {
                                    <div class="muted small ellipsis hide-narrow" title="@track.FilePath">@track.FilePath</div>
                                }
                                <div class="show-narrow"><StatusBadge Track="track.Status" /></div>
                            </td>
                            <td class="num hide-narrow muted">@Format.Duration(track.DurationSeconds)</td>
                            <td class="hide-narrow"><StatusBadge Track="track.Status" /></td>
                            <td class="num actions">
                                @if (track.Status is TrackStatus.Owned or TrackStatus.OwnedElsewhere)
                                {
                                    <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="Play the tracks you have from here" OnClick="() => PlayOwnedFromAsync(track)" />
                                    <QueueButton Title="Add to the queue: next, or at the end"
                                                OnQueue="next => Player.AddAsync([PlayerEntry.Owned(track, album, _album.ShownEditionId)], next)" />
                                    <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Class="hide-narrow" Title="Add to a playlist"
                                                OnClick="() => _adding = (track.Title, [new PlaylistItem(track.TrackId)])" />
                                }
                                else if (track.Status is TrackStatus.Missing or TrackStatus.Elsewhere && Tracker.Find(RequestKind.Album, album.Id) is not { Active: true })
                                {
                                    <FetchButton Kind="RequestKind.Track" Id="track.TrackId" EditionId="_album.ShownEditionId" Hint="Get it into your library">
                                        <IconButton Icon="listen" Requires="@UserPermissions.Listen" Title="Listen: fetch it to play now, without adding it to your library"
                                                    OnClick="() => Player.ListenAsync(track.TrackId, _album.ShownEditionId)" />
                                        <IconButton Icon="queue" Requires="@UserPermissions.Listen" Class="hide-narrow" Title="Add to the queue, fetching it to listen to" Confirm="true"
                                                    OnClick="() => Player.ListenAsync(track.TrackId, _album.ShownEditionId, next: true)" />
                                        @if (track.Status == TrackStatus.Missing)
                                        {
                                            <IconButton Icon="ignore" Requires="@UserPermissions.Request" Class="hide-narrow" Title="Ignore: stop counting this song as missing, on every album it's on"
                                                        OnClick="() => ToggleTrackIgnoredAsync(track)" />
                                        }
                                    </FetchButton>
                                }
                                @if (track.Status == TrackStatus.Ignored || track.Ignored)
                                {
                                    <IconButton Icon="unignore" Requires="@UserPermissions.Request" Title="Unignore: count this song again" OnClick="() => ToggleTrackIgnoredAsync(track)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_choosingCover && _album is not null)
{
    <CoverDialog Subject="CoverSubject.Album" Id="_album.Album.Id" Name="@_album.Album.Title" OnClose="() => _choosingCover = false"
                 OnChosen="url => _album = _album with { Album = _album.Album with { CoverUrl = url } }" />
}

@if (_adding is { } adding)
{
    <AddToPlaylistDialog Name="@adding.Name" Songs="adding.Songs" OnClose="() => _adding = null" />
}

@if (_formatting && _album is not null)
{
    <FormatDialog Scope="new FormatScope(FormatScopeKind.Album, _album.Album.Id)" Name="@_album.Album.Title" OnClose="() => _formatting = false" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    // The same for the tracks on their way and those arrived, so they slot in without anything moving.
    private static readonly RenderFragment TrackHead = @<text>
        <colgroup><col class="num-col" /><col /><col class="length-col hide-narrow" /><col class="status-col" /><col class="wide-action-col" /></colgroup>
        <thead>
            <tr>
                <th class="num">#</th>
                <th>Title</th>
                <th class="num hide-narrow">Length</th>
                <th class="hide-narrow">Status</th>
                <th></th>
            </tr>
        </thead>
    </text>;

    private AlbumDetail? _album;
    private AlbumGlimpse? _glimpse;
    // The edition being changed to, until its tracks arrive.
    private Guid? _switching;
    private bool _notFound;
    private bool _formatting;
    private bool _choosingCover;
    private (string Name, IReadOnlyList<PlaylistItem> Songs)? _adding;

    private static bool Owned(TrackRow track) => track.Status is TrackStatus.Owned or TrackStatus.OwnedElsewhere;

    private bool MultiDisc => _album!.Tracks.Select(t => t.Disc).Distinct().Count() > 1;

    private sealed record Slot(int Index, string Number, LibraryTrack? Owned);

    // The tracks of the edition on its way, in order: those you have filled in, the rest blank until they arrive.
    private List<Slot> Slots()
    {
        var edition = _switching is { } switching ? _album?.Editions.FirstOrDefault(e => e.Id == switching) : null;
        // Your songs are numbered as on the edition you have, so they're put in their places only on that one.
        var owned = _glimpse is not null && (_switching is null || _switching == _album?.OwnedEditionId) ? _glimpse.Owned : [];
        var count = edition?.TrackCount ?? (_switching is null ? _glimpse?.Album.TotalTracks : null) ?? 0;
        var ordered = owned.OrderBy(t => t.Disc ?? 1).ThenBy(t => int.TryParse(t.Number, out var n) ? n : int.MaxValue).ToList();
        var slots = new List<Slot>();
        if (ordered.Select(t => t.Disc ?? 1).Distinct().Count() > 1)
        {
            // Over several discs a count doesn't say where each goes: yours first, then the rest.
            foreach (var track in ordered)
                slots.Add(new Slot(slots.Count, $"{track.Disc}-{track.Number}", track));
            while (slots.Count < count)
                slots.Add(new Slot(slots.Count, "", null));
            return slots;
        }
        var numbered = ordered.Where(t => int.TryParse(t.Number, out var n) && n > 0).DistinctBy(t => int.Parse(t.Number!)).ToDictionary(t => int.Parse(t.Number!));
        count = Math.Max(count, numbered.Keys.DefaultIfEmpty().Max());
        // Nothing to go by: a few, to show something's coming.
        if (count == 0)
            count = 8;
        for (var i = 1; i <= count; i++)
            slots.Add(new Slot(i, i.ToString(), numbered.GetValueOrDefault(i)));
        return slots;
    }

    protected override Task OnParametersSetAsync()
    {
        ScanStatus.LibraryChanged -= Reload;
        ScanStatus.LibraryChanged += Reload;
        Tracker.Changed -= Redraw;
        Tracker.Changed += Redraw;
        Player.Changed -= Redraw;
        Player.Changed += Redraw;
        return LoadAsync(null);
    }

    private void Reload() => InvokeAsync(async () =>
    {
        await LoadAsync(_album?.ShownEditionId);
        StateHasChanged();
    });

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _following?.Cancel();
        ScanStatus.LibraryChanged -= Reload;
        Tracker.Changed -= Redraw;
        Player.Changed -= Redraw;
    }

    private Task PlayOwnedFromAsync(TrackRow from)
    {
        var owned = _album!.Tracks.Where(t => t.Status is TrackStatus.Owned or TrackStatus.OwnedElsewhere).ToList();
        return Player.PlayAsync(owned.Select(t => PlayerEntry.Owned(t, _album.Album, _album.ShownEditionId)).ToList(), owned.IndexOf(from));
    }

    private async Task LoadAsync(Guid? editionId)
    {
        // Seen already this session: shown as it was while it's asked for again. Only as it first opens, with no edition chosen.
        if (editionId is null && Pages.Get<AlbumDetail>(Key(Id)) is { } seen)
        {
            _album = seen;
            _notFound = false;
        }
        else if (_album?.Album.Id != Id)
        {
            // New to this session: what the list it was opened from knew, until the rest arrives.
            _album = null;
            _glimpse = Glimpses.Album(Id);
            _notFound = false;
        }
        var album = await Api.GetAlbumAsync(Id, editionId, quick: true);
        _album = editionId is null ? Pages.Keep(Key(Id), album) : album;
        _notFound = _album is null;
        if (_album is not null)
            Glimpses.Saw(_album);
        Follow();
    }

    // The tracks shown go blank, but for those you have, until the edition's arrive.
    private async Task ShowEditionAsync(Guid? editionId)
    {
        _switching = editionId;
        _glimpse ??= Glimpses.Album(Id);
        try
        {
            await LoadAsync(editionId);
        }
        finally
        {
            _switching = null;
        }
    }

    private static string Key(Guid id) => $"album/{id}";

    // While its editions are fetched, look again every moment; the page shows what's known meanwhile.
    private CancellationTokenSource? _following;

    private void Follow()
    {
        _following?.Cancel();
        if (_album is not { Fetching: true })
            return;
        var following = _following = new CancellationTokenSource();
        var id = Id;
        _ = InvokeAsync(async () =>
        {
            try
            {
                while (_album is { Fetching: true } && !following.IsCancellationRequested)
                {
                    await Task.Delay(1500, following.Token);
                    if (await Api.GetAlbumAsync(id, _album?.ShownEditionId, quick: true, following.Token) is { } album && !following.IsCancellationRequested)
                    {
                        _album = album;
                        if (album.ShownEditionId == album.OwnedEditionId)
                            Pages.Keep(Key(id), album);
                        StateHasChanged();
                    }
                }
            }
            catch (Exception e) when (e is OperationCanceledException or HttpRequestException)
            {
            }
        });
    }

    private async Task ToggleTrackIgnoredAsync(TrackRow track)
    {
        await Api.SetTrackIgnoredAsync(track.TrackId, !track.Ignored);
        await LoadAsync(_album!.ShownEditionId);
    }

    private Task ChangeEditionAsync(ChangeEventArgs e) => ShowEditionAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private string EditionLabel(EditionSummary e)
    {
        var parts = new[] { e.ReleaseDate, e.Country, Formats(e.Formats), e.Disambiguation, e.Status is "Official" ? null : e.Status }
            .Where(p => !string.IsNullOrEmpty(p));
        var owned = e.FilesInLibrary > 0 ? $" · {e.FilesInLibrary} files in library" : "";
        return $"{e.Title} ({string.Join(", ", parts)}) · {e.TrackCount} tracks{owned}";
    }

    // "CD, CD" reads better as "2×CD".
    private static string? Formats(string? formats) => formats is null ? null : string.Join(", ",
        formats.Split(", ").GroupBy(f => f).Select(g => g.Count() > 1 ? $"{g.Count()}×{g.Key}" : g.Key));
}
