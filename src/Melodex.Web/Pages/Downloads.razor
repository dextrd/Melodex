@page "/downloads"
@implements IDisposable
@inject MelodexClient Api
@inject AuthState Auth
@inject Player Player
@inject ServerEvents Events
@inject Preferences Prefs

<PageTitle>Downloads · Melodex</PageTitle>

@*
    Tracks fetched to listen to. Now shows those still to play or add; all time adds those discarded, expired or added
    to the library.
*@
<h1>Downloads</h1>
<p class="muted">
    Tracks fetched to listen to without adding them to your library. Each is kept for @Format.Minutes(_expiry) after you last
    play it, unless you add it.
</p>

<div class="toolbar">
    <Segmented T="bool" Value="_all" Options="Tabs" OnChange="ShowAsync" Label="Show" />
    @if (_items is { Count: > 0 })
    {
        var playable = Playable;
        <button class="primary" disabled="@(playable.Count == 0)" @onclick="() => PlayAsync(playable, 0)">Play all</button>
    }
    @if (_error is not null) { <span class="error small" title="@_error">@_error</span> }
</div>

@if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <div class="empty card">
        @if (_all) { <span>Nothing fetched to listen to yet. Use the listen buttons on album and search pages.</span> }
        else
        {
            <span>Nothing to play or add right now. </span>
            <button class="link" @onclick="() => ShowAsync(true)">Show all time</button>
        }
    </div>
}
else
{
    var playable = Playable;
    <div class="card">
        @foreach (var group in Groups())
        {
            if (group.Items.Count == 1)
            {
                @Row(group.Items[0], playable, number: null)
                continue;
            }
            var albumId = group.AlbumId!.Value;
            var open = _openAlbums.Contains(albumId);
            var first = group.Items[0];
            var ready = group.Items.Where(playable.Contains).ToList();
            var addable = group.Items.Where(i => i.State == ListenNowState.Playable).ToList();
            var discardable = group.Items.Where(Discardable).ToList();
            <section class="listen-album" aria-label="@first.AlbumTitle">
                <div class="listen-item toggled">
                    <button class="listen-toggle" aria-expanded="@(open ? "true" : "false")" aria-label="@(open ? "Hide its songs" : "Show its songs")"
                            @onclick="() => ToggleAlbum(albumId)">
                        <span class="chevron @(open ? "open" : "")" aria-hidden="true"></span>
                    </button>
                    <Cover Url="@first.CoverUrl" />
                    <div style="min-width: 0;">
                        <div class="ellipsis"><button class="link listen-album-title" @onclick="() => ToggleAlbum(albumId)"><strong>@first.AlbumTitle</strong></button></div>
                        <div class="muted small ellipsis">
                            @if (first.ArtistId is { } artist) { <a class="muted" href="artists/@artist">@first.ArtistCredit</a> } else { @first.ArtistCredit }
                            <span> · </span><a class="muted" href="albums/@albumId">@Format.Count(group.Items.Count, "song", "songs")</a>
                        </div>
                        <div class="row small listen-status">
                            @foreach (var (label, badge, count) in Summary(group.Items))
                            {
                                <span class="badge @badge">@count @label.ToLowerInvariant()</span>
                            }
                        </div>
                    </div>
                    <div class="listen-actions">
                        <IconButton Icon="play" Requires="@UserPermissions.Listen" Disabled="@(ready.Count == 0)" Title="Play its songs, in order"
                                    OnClick="() => PlayAsync(ready, 0)" />
                        <QueueButton Title="Add its songs to the queue: next, or at the end" OnQueue="next => Player.AddAsync(ready.Select(PlayerEntry.Listening).ToList(), next)" />
                        @if (addable.Count > 0)
                        {
                            <IconButton Icon="add" Disabled="@ScanStatus.Reading"
                                        Title="@(ScanStatus.Reading ? "Wait until the scan has read your files" : $"Add the {Format.Count(addable.Count, "song", "songs")} ready to play to your library")"
                                        OnClick="() => EachAsync(addable, i => Api.AddListeningAsync(i.Id))" />
                        }
                        @if (discardable.Count > 0)
                        {
                            <IconButton Icon="discard" Confirm="true" Title="@($"Delete its {Format.Count(discardable.Count, "song", "songs")}, or stop fetching them")"
                                        OnClick="() => EachAsync(discardable, i => Api.DiscardListeningAsync(i.Id))" />
                        }
                    </div>
                </div>
                @if (open)
                {
                    <div class="listen-album-songs">
                        @foreach (var item in group.Items)
                        {
                            @Row(item, playable, Number(item, group.Items))
                        }
                    </div>
                }
            </section>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<(bool Value, string Label, string? Hint)> Tabs =
        [(false, "Now", "Still to play, fetch or add"), (true, "All time", "Including those deleted or added to the library")];

    private const string AllKey = "downloadsAll";

    // A song: on its own, with its cover; on an album opened, with its number. Opened, it shows how it was fetched.
    private RenderFragment Row(ListenNowInfo item, List<ListenNowInfo> playable, string? number) =>
        @<div class="listen-song">
            <div class="listen-item toggled">
                <button class="listen-toggle" aria-expanded="@(_openItems.ContainsKey(item.RequestId) ? "true" : "false")"
                        aria-label="@(_openItems.ContainsKey(item.RequestId) ? "Hide how it was fetched" : "Show how it was fetched")"
                        @onclick="() => ToggleItemAsync(item)">
                    <span class="chevron @(_openItems.ContainsKey(item.RequestId) ? "open" : "")" aria-hidden="true"></span>
                </button>
                @if (number is null) { <Cover Url="@item.CoverUrl" /> } else { <span class="listen-number muted">@number</span> }
                <div style="min-width: 0;">
                    <div class="ellipsis"><strong>@item.Title</strong></div>
                    @if (number is null)
                    {
                        <div class="muted small ellipsis">
                            @if (item.ArtistId is { } artist) { <a class="muted" href="artists/@artist">@item.ArtistCredit</a> } else { @item.ArtistCredit }
                            @if (item.AlbumId is { } album) { <span> · </span><a class="muted" href="albums/@album">@item.AlbumTitle</a> }
                        </div>
                    }
                    <div class="row small listen-status">
                        <span class="badge @(item.Paused && item.Pending ? "neutral" : Badge(item.State))" title="@item.Detail">@Label(item)</span>
                        @if (item.State == ListenNowState.Playable && item.ExpiresAt is { } expires)
                        {
                            <span class="muted" title="@expires.ToLocalTime().ToString("f")">Deleted @Format.Until(expires)</span>
                        }
                        @if (item.State == ListenNowState.Failed && item.Detail is not null)
                        {
                            <span class="muted ellipsis" title="@item.Detail">@item.Detail</span>
                        }
                        @if (item.Codec is not null)
                        {
                            <span class="muted hide-narrow">@item.Codec.ToUpperInvariant()@(item.BitrateKbps is { } kbps ? $" · {kbps} kbps" : "")</span>
                        }
                    </div>
                </div>
                <div class="listen-actions">
                    @if (item.State is ListenNowState.Playable or ListenNowState.Importing or ListenNowState.InLibrary || item.Pending)
                    {
                        <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="@(Player.IsNow(item.TrackId) ? "Playing" : "Play")" Primary="@Player.IsNow(item.TrackId)"
                                    OnClick="() => PlayAsync(playable, playable.IndexOf(item))" />
                        <QueueButton Title="Add to the queue: next, or at the end" OnQueue="next => Player.AddAsync([PlayerEntry.Listening(item)], next)" />
                    }
                    @if (item.State == ListenNowState.Playable)
                    {
                        <IconButton Icon="add" Disabled="@ScanStatus.Reading"
                                    Title="@(ScanStatus.Reading ? "Wait until the scan has read your files" : "Add to your library, without fetching it again")"
                                    OnClick="() => AddAsync(item)" />
                    }
                    @if (item.State == ListenNowState.Requested && !item.Paused && Waiting.IndexOf(item) is var place and >= 0)
                    {
                        <IconButton Icon="up" Title="Fetch sooner" Disabled="@(place == 0)" OnClick="() => MoveAsync(item, place - 1)" />
                        <IconButton Icon="down" Title="Fetch later" Disabled="@(place == Waiting.Count - 1)" OnClick="() => MoveAsync(item, place + 2)" />
                    }
                    @if (item.Pending)
                    {
                        @if (item.Paused)
                        {
                            <IconButton Icon="play" Requires="@UserPermissions.Request" Title="Resume fetching" OnClick="() => RunAsync(() => Api.ResumeRequestAsync(item.RequestId))" />
                        }
                        else
                        {
                            <IconButton Icon="pause" Title="@(item.State == ListenNowState.Fetching ? "Pause: it fetches again from the start when resumed" : "Pause")"
                                        OnClick="() => RunAsync(() => Api.PauseRequestAsync(item.RequestId))" />
                        }
                    }
                    @if (Discardable(item))
                    {
                        <IconButton Icon="discard" Title="@(item.Pending ? "Stop fetching it" : "Delete it now")" OnClick="() => DiscardAsync(item)" />
                    }
                </div>
            </div>
            @if (_openItems.TryGetValue(item.RequestId, out var detail))
            {
                <div class="listen-detail">
                    @if (detail is null) { <Loading Inline="true" /> } else { <RequestDetail Request="detail" OnChanged="LoadAsync" /> }
                </div>
            }
        </div>;

    /// <summary>Songs from one album, or a song from none.</summary>
    private sealed record Group(Guid? AlbumId, List<ListenNowInfo> Items);

    // Songs from the same album as one, in the album's order, where the first of them would be; the rest each on their own.
    private List<Group> Groups()
    {
        var groups = new List<Group>();
        var albums = new Dictionary<Guid, Group>();
        foreach (var item in _items!)
        {
            if (item.AlbumId is { } album && albums.TryGetValue(album, out var group))
                group.Items.Add(item);
            else
            {
                group = new Group(item.AlbumId, [item]);
                groups.Add(group);
                if (item.AlbumId is { } id)
                    albums[id] = group;
            }
        }
        foreach (var group in groups)
            group.Items.Sort((a, b) => (a.Disc ?? int.MaxValue, a.Position ?? int.MaxValue).CompareTo((b.Disc ?? int.MaxValue, b.Position ?? int.MaxValue)));
        return groups;
    }

    private static string Number(ListenNowInfo item, List<ListenNowInfo> album) =>
        item.Position is not { } position ? "" : album.Select(i => i.Disc).Distinct().Count() > 1 ? $"{item.Disc}-{position}" : $"{position}";

    // How an album's songs stand: how many are ready, fetching and so on.
    private static IEnumerable<(string Label, string Badge, int Count)> Summary(List<ListenNowInfo> items) =>
        items.GroupBy(i => (Label(i), i.Paused && i.Pending ? "neutral" : Badge(i.State))).Select(g => (g.Key.Item1, g.Key.Item2, g.Count()));

    private static bool Discardable(ListenNowInfo item) => item.State is not (ListenNowState.Importing or ListenNowState.InLibrary or ListenNowState.Expired);

    private readonly HashSet<Guid> _openAlbums = [];
    // Songs opened to show how they were fetched, by their request; null while it's on its way.
    private readonly Dictionary<Guid, RequestInfo?> _openItems = [];

    private void ToggleAlbum(Guid album)
    {
        if (!_openAlbums.Remove(album))
            _openAlbums.Add(album);
    }

    private async Task ToggleItemAsync(ListenNowInfo item)
    {
        if (_openItems.Remove(item.RequestId))
            return;
        _openItems[item.RequestId] = null;
        StateHasChanged();
        _openItems[item.RequestId] = await Api.GetRequestAsync(item.RequestId);
    }

    private async Task EachAsync(List<ListenNowInfo> items, Func<ListenNowInfo, Task> action)
    {
        _error = null;
        try
        {
            foreach (var item in items)
                await action(item);
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
    }

    // Include those discarded, expired or added to the library.
    private bool _all;
    private IReadOnlyList<ListenNowInfo>? _items;

    // In the order shown: an album's songs in its order.
    private List<ListenNowInfo> Playable => Groups().SelectMany(g => g.Items).Where(i => i.State is not (ListenNowState.Failed or ListenNowState.Expired)).ToList();
    private int _expiry = 60;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Events.Received += OnEvent;
        Player.Changed += Redraw;
        _all = await Prefs.GetAsync(AllKey, false);
        // Only someone who may read the settings can see how long songs are kept; the rest see the usual hour.
        if (Auth.May(UserPermissions.Settings))
            _expiry = (await Api.GetFetchSettingsAsync()).ListenNowExpiryMinutes;
        await LoadAsync();
    }

    private async Task ShowAsync(bool all)
    {
        _all = all;
        await Prefs.SetAsync(AllKey, all);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var all = _all;
        var items = await Api.ListListeningAsync(all);
        // Those still to fetch first, in the order they'll be fetched; then the rest, newest first.
        if (all == _all)
            _items = items.Where(i => i.Pending).OrderBy(i => i.QueueOrder).ThenBy(i => i.CreatedAt)
                .Concat(items.Where(i => !i.Pending)).ToList();
    }

    private void OnEvent(string type)
    {
        if (type is "listen" or "connected")
            InvokeAsync(async () =>
            {
                await LoadAsync();
                // How songs still being fetched were fetched changes as they are.
                foreach (var id in _openItems.Keys.ToList())
                    if (_items?.FirstOrDefault(i => i.RequestId == id) is { Pending: true } || _openItems[id]?.Active == true)
                        _openItems[id] = await Api.GetRequestAsync(id);
                StateHasChanged();
            });
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private Task PlayAsync(List<ListenNowInfo> items, int start) =>
        Player.PlayAsync(items.Select(PlayerEntry.Listening).ToList(), Math.Max(start, 0));

    private async Task AddAsync(ListenNowInfo item)
    {
        _error = null;
        try
        {
            await Api.AddListeningAsync(item.Id);
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
    }

    /// <summary>Tracks waiting to be fetched, in the order they will be.</summary>
    private List<ListenNowInfo> Waiting => _items!.Where(i => i.State == ListenNowState.Requested && !i.Paused).ToList();

    // To just before the track now at this place among those waiting, or to the end past it.
    private Task MoveAsync(ListenNowInfo item, int place) =>
        RunAsync(() => Api.MoveRequestAsync(item.RequestId, place < Waiting.Count ? Waiting[place].RequestId : null));

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
    }

    private async Task DiscardAsync(ListenNowInfo item)
    {
        _error = null;
        try
        {
            await Api.DiscardListeningAsync(item.Id);
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
    }

    private static string Label(ListenNowInfo item) => item.State switch
    {
        ListenNowState.Requested or ListenNowState.Fetching when item.Paused => "Paused",
        ListenNowState.Requested => "Waiting",
        ListenNowState.Fetching => "Fetching",
        ListenNowState.Playable => "Ready to play",
        ListenNowState.Importing => "Adding to library",
        ListenNowState.InLibrary => "In library",
        ListenNowState.Failed => "Couldn't fetch",
        _ => "Deleted",
    };

    private static string Badge(ListenNowState state) => state switch
    {
        ListenNowState.Playable => "covered",
        ListenNowState.InLibrary => "owned",
        ListenNowState.Failed => "missing",
        ListenNowState.Expired => "neutral",
        ListenNowState.Requested => "active waiting",
        _ => "active",
    };

    public void Dispose()
    {
        Events.Received -= OnEvent;
        Player.Changed -= Redraw;
    }
}
