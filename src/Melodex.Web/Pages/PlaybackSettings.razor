@page "/settings/playback"
@layout SettingsLayout
@inject MelodexClient Api
@inject Player Player
@inject TaskNotices Tasks

<PageTitle>Playback · Melodex</PageTitle>

@if (_status is null || _fetch is null)
{
    <Loading />
}
else
{
    <h2>Gapless playback</h2>
    <p class="muted small">
        Songs that run into each other, as on a live album, a DJ mix or a symphony, play on without a pause between them: the next song is loaded while
        this one plays, and started as it ends.
    </p>
    @if (!_gaplessWorks)
    {
        <div class="notice warning" role="status">
            ⚠ Not on this device. On iPhones and iPads, in any browser, songs play one after another with a moment between them: running them into
            each other left the lock screen's music controls showing the song before, paused. The setting still counts on your other devices.
        </div>
    }
    <div class="card settings-card">
        @foreach (var (value, name, hint) in GaplessChoices)
        {
            <label class="dialog-choice">
                <input type="radio" name="gapless" checked="@(_gapless == value)" @onchange="() => { _gapless = value; _saver?.Changed(); }" />
                <span>
                    <strong>@name</strong>
                    <span class="muted small">@hint</span>
                </span>
            </label>
        }
    </div>

    <h2 id="visualiser">Visualiser</h2>
    <p class="muted small">
        The bars that move with the music under the cover in the full-screen player. The server works them out from each song, so your browser doesn't
        download it twice to draw them.
    </p>
    <div class="card settings-card">
        @foreach (var (value, name, hint) in Choices)
        {
            <label class="dialog-choice">
                <input type="radio" name="visualiser" checked="@(_visualiser == value)" @onchange="() => Choose(value)" />
                <span>
                    <strong>@name</strong>
                    <span class="muted small">@hint</span>
                </span>
            </label>
        }
        @if (_status.BarsFiles > 0)
        {
            <div class="muted small">
                @Plural(_status.BarsFiles, ".bars file", ".bars files") beside your songs take @Size(_status.BarsBytes).
                @if (_visualiser != VisualiserBars.WhenMatching)
                {
                    <button class="link small" @onclick="() => _deleting = true">Delete them</button>
                }
            </div>
        }
        @* Only while bars sit beside songs: made as songs play, or with no visualiser, there are none to make. *@
        @if (_status.Settings.Visualiser == VisualiserBars.WhenMatching)
        {
            <div class="setting-line">
                <ScheduleNote Task="ScheduledTask.Bars" />
                <span class="spacer"></span>
                <button disabled="@_makingBars" @onclick="MakeBarsAsync">@if (_makingBars) { <span class="spinner"></span> }Make missing bars now</button>
            </div>
            @if (_barsError is not null) { <div class="error small">@_barsError</div> }
        }
    </div>

    <h2>Listen now</h2>
    <div class="card settings-card">
        <div class="setting-line">
            Keep listen-now tracks for
            <NumberField Min="5" Max="10080" Step="5" Label="Minutes" Value="_fetch.ListenNowExpiryMinutes" ValueChanged="n => { _fetch = _fetch with { ListenNowExpiryMinutes = n }; _saver?.Changed(); }" />
            minutes after they were last played
        </div>
        <div class="muted small">A track fetched to listen to, and not added to the library, is deleted after this.</div>
        <div class="setting-line">
            Fetch
            <NumberField Min="0" Max="20" Label="Songs ahead" Value="_fetch.ListenNowAhead" ValueChanged="n => { _fetch = _fetch with { ListenNowAhead = n }; _saver?.Changed(); }" />
            songs ahead of the one playing, and
            <NumberField Min="0" Max="20" Label="Songs behind" Value="_fetch.ListenNowBehind" ValueChanged="n => { _fetch = _fetch with { ListenNowBehind = n }; _saver?.Changed(); }" />
            behind it
        </div>
        <div class="muted small">
            Playing an album you don't have all of puts all of it in the queue, but only the songs you don't have this near the one playing are
            fetched to listen to. The rest are fetched as the queue comes to them.
        </div>
    </div>

    <h2 id="radio">Radio</h2>
    <div class="card settings-card">
        <div class="setting-line">
            Aim for
            <NumberField Min="0" Max="100" Step="5" Label="Percent" Value="_fetch.RadioMissingPercent" ValueChanged="n => { _fetch = _fetch with { RadioMissingPercent = n }; _saver?.Changed(); }" />
            % of the songs a radio plays to be ones not in the library
        </div>
        <div class="muted small">
            For everyone's radios. Those songs are fetched to listen to as they come near, without adding them to the library. A radio keeps to
            this over the songs it plays: when it finds too few of one kind, it makes up for it later. 0 plays only songs you have, 100 only ones
            you don't.
        </div>
    </div>

    <AutoSave @ref="_saver" Save="SaveAsync" />

    @if (_warning)
    {
        <Dialog Title="Keep bars beside every song?" OnClose="() => { _warning = false; _visualiser = _status.Settings.Visualiser; }" Alert="true">
            <p>
                Every song in your library gets a .bars file beside it, made after each scan, starting with the next. For your
                @Plural(_status.Songs, "song", "songs") that's about <strong>@Size(_status.EstimatedBytes)</strong> in your music folder,
                about 1.4 KB for each second of music.
            </p>
            <p class="muted small">
                Making them takes a second or so a song, one after another, so a large library takes hours the first time. Media servers pass the
                files by, and they move and go with their songs.
            </p>
            <div class="toolbar dialog-buttons">
                <button @onclick="() => { _warning = false; _visualiser = _status.Settings.Visualiser; }">Cancel</button>
                <button class="primary" @onclick="() => { _warning = false; _saver?.Changed(); }">Keep bars beside songs</button>
            </div>
        </Dialog>
    }

    <LastFmApiKey />

    @if (_deleting)
    {
        <Dialog Title="Delete the .bars files?" OnClose="CloseDeleting" Alert="true">
            <p>@DeletingText</p>
            <div class="toolbar dialog-buttons">
                <button @onclick="() => FinishLeavingAsync(false)">Keep them</button>
                <button class="danger" @onclick="() => FinishLeavingAsync(true)">Delete them</button>
            </div>
        </Dialog>
    }
}

@code {
    private static readonly (VisualiserBars Value, string Name, string Hint)[] Choices =
    [
        (VisualiserBars.OnDemand, "On demand",
            "Made for the song playing when the visualiser shows, and the next in the queue ahead of it. Kept a while in Melodex's data folder, then forgotten."),
        (VisualiserBars.WhenMatching, "When matching",
            "Made for every song after each scan and kept beside it in a .bars file, like lyrics, so they're ready when it plays."),
        (VisualiserBars.Off, "Off", "No visualiser: its button is gone from the full-screen player."),
    ];

    private static readonly (GaplessPlayback Value, string Name, string Hint)[] GaplessChoices =
    [
        (GaplessPlayback.SameAlbum, "Songs from the same album",
            "One song after another from the same album, as the record plays them. Between albums, there's the usual moment's pause."),
        (GaplessPlayback.Always, "Every song", "Every song in the queue runs into the next."),
        (GaplessPlayback.Off, "Off", "Each song starts once the one before has ended, after a moment to load. Nothing's downloaded ahead."),
    ];

    private PlaybackStatus? _status;
    private GaplessPlayback _gapless;
    private FetchSettings? _fetch;
    private VisualiserBars _visualiser;
    private bool _warning, _deleting, _leaving, _deleteBarsFiles;
    private AutoSave? _saver;
    private bool _gaplessWorks = true;
    private bool _makingBars;
    private string? _barsError;

    private async Task MakeBarsAsync()
    {
        _makingBars = true;
        _barsError = null;
        try
        {
            Tasks.Started(await Api.MakeBarsAsync());
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _barsError = e.Message;
        }
        _makingBars = false;
    }

    protected override async Task OnInitializedAsync()
    {
        _status = await Api.GetPlaybackSettingsAsync();
        _fetch = await Api.GetFetchSettingsAsync();
        _visualiser = _status.Settings.Visualiser;
        _gapless = _status.Settings.Gapless;
        _gaplessWorks = await Player.GaplessWorksAsync();
    }

    // Saved as it's chosen, except that making bars beside every song is warned of first, for the room they take,
    // and leaving that asks whether to delete the files made.
    private void Choose(VisualiserBars value)
    {
        _visualiser = value;
        var was = _status!.Settings.Visualiser;
        if (value == VisualiserBars.WhenMatching && was != VisualiserBars.WhenMatching)
            _warning = true;
        else if (was == VisualiserBars.WhenMatching && value != VisualiserBars.WhenMatching)
            _leaving = _deleting = true;
        else
            _saver?.Changed();
    }

    private async Task SaveAsync()
    {
        await Api.SavePlaybackSettingsAsync(new SavePlayback(_visualiser, _deleteBarsFiles, _gapless));
        _deleteBarsFiles = false;
        await Api.SaveFetchSettingsAsync(_fetch!);
        _status = await Api.GetPlaybackSettingsAsync();
    }

    // Asked whether to delete them: on leaving bars made when matching, with the change; otherwise on their own.
    private async Task FinishLeavingAsync(bool delete)
    {
        _deleting = false;
        if (!_leaving && !delete)
            return;
        _leaving = false;
        _deleteBarsFiles = delete;
        if (_saver is not null)
            await _saver.SaveNowAsync();
    }

    // Closed without an answer: on leaving bars made when matching, the change is taken back.
    private void CloseDeleting()
    {
        _deleting = false;
        if (_leaving)
            _visualiser = _status!.Settings.Visualiser;
        _leaving = false;
    }

    private string DeletingText =>
        (_status!.BarsFiles == 0 ? "Any beside your songs are deleted." : $"{Plural(_status.BarsFiles, ".bars file is", ".bars files are")} beside your songs, taking {Size(_status.BarsBytes)}. ")
        + (_visualiser == VisualiserBars.Off ? "With the visualiser off, they aren't used." : "Kept, they're used instead of making bars when a song plays.");

    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n:N0} {many}";

    private static string Size(long bytes)
    {
        const double mb = 1024 * 1024, gb = mb * 1024;
        if (bytes >= gb)
            return $"{bytes / gb:0.0} GB";
        return bytes >= mb ? $"{bytes / mb:0} MB" : $"{Math.Max(1, bytes / 1024.0):0} KB";
    }
}
