@page "/playlists/{Id:guid}"
@implements IDisposable
@inject MelodexClient Api
@inject AuthState Auth
@inject Player Player
@inject RequestTracker Tracker
@inject NavigationManager Nav

<PageTitle>@(_playlist is null ? "Playlist" : PlaylistNames.Leaf(_playlist.Playlist.Name, Delimiter)) · Melodex</PageTitle>

@* A playlist is part of the Library: its heading and tabs stay, as they don't on pages that can lead outside it. *@
<h1>Library</h1>
<LibraryTabs Current="playlists" />

@if (_notFound)
{
    <div class="empty card">That playlist isn't yours, or it's been deleted.</div>
}
else if (_playlist is null)
{
    <Loading />
}
else
{
    var summary = _playlist.Playlist;
    var folders = PlaylistNames.Folders(summary.Name, Delimiter);
    var playable = PlaylistNames.Playable(_playlist.Songs);
    @* The way back sits above the head, so the cover is as tall as the title, details and buttons beside it. *@
    <div class="muted small crumbs"><a href="playlists">Playlists</a>@foreach (var folder in folders) { <text> › @folder</text> }</div>
    <div class="page-head">
        <PlaylistCover Covers="summary.Covers" />
        <div>
            <h2 class="title">@PlaylistNames.Leaf(summary.Name, Delimiter)</h2>
            @if (summary.Comment is not null) { <p class="muted">@summary.Comment</p> }
            <div class="row muted small">
                <span>@PlaylistNames.Length(summary.Count, summary.DurationSeconds)</span>
                @switch (summary.Sync)
                {
                    case PlaylistSyncState.Synced:
                        <span class="badge neutral" title="The same on the media server">Synced</span>
                        break;
                    case PlaylistSyncState.Waiting:
                        <span class="badge neutral" title="Changed since the last sync, or has songs the media server hasn't found yet">Waiting to sync</span>
                        break;
                }
            </div>
            <div class="row album-actions" style="margin-top: .5rem;">
                <IconButton Icon="play" Requires="@UserPermissions.Listen" Primary="true" Large="true" Label="Play" Title="Play the playlist" Disabled="playable.Count == 0"
                            OnClick="() => Player.PlayAsync(playable, from: From)" />
                <IconButton Icon="shuffle" Requires="@UserPermissions.Listen" Large="true" Title="Shuffle: play in a random order" Disabled="playable.Count == 0"
                            OnClick="() => Player.PlayAsync(playable.OrderBy(_ => Random.Shared.Next()).ToList(), from: From)" />
                <QueueButton Large="true" Left="true" Title="Add to the queue: play next, or play last" Disabled="playable.Count == 0"
                            OnQueue="next => Player.AddAsync(playable, next, From)" />
                <IconButton Icon="radio" Requires="@UserPermissions.Listen" Large="true" Title="Start radio: play songs like the playlist's, without end"
                            Disabled="playable.Count == 0" OnClick="() => Player.StartRadioAsync(summary.Id)" />
                @if (Awaiting.Count > 0 && Auth.May(UserPermissions.Request))
                {
                    <IconButton Icon="get" Large="true" Label="@($"Get {Awaiting.Count}")" Disabled="_busy"
                                Title="@($"Get the {Format.Count(Awaiting.Count, "song", "songs")} you don't have into your library; each fills its place as it arrives")"
                                OnClick="GetAwaitingAsync" />
                }
                <IconButton Icon="rename" Large="true" Label="Edit" Title="Rename it, move it to another folder, change its comment, or choose where songs you add go" OnClick="StartRename" />
                <IconButton Icon="export" Large="true" Title="Export it, as an M3U8 playlist or a CSV" OnClick="@(() => Nav.NavigateTo($"tools/export?playlist={Id}"))" />
                <PlaylistMenu Large="true" Pinned="summary.Pinned" OnPin="PinAsync" OnEdit="StartRename" OnPicture="() => _choosingCover = true"
                              OnRemove="() => _deleting = true" RemoveLabel="Delete the playlist…" />
            </div>
        </div>
    </div>

    @if (_error is not null) { <p class="error small">@_error</p> }

    @if (_playlist.Songs.Count == 0)
    {
        <div class="empty card">Nothing in it yet. Add songs from a song's or album's page, or from the player.</div>
    }
    else
    {
        <div class="card" style="@Format.NumberColumn(_playlist.Songs.Count)">
            <table class="table track-list playlist-songs slots" data-reorder>
                @* Fixed widths, so the columns stay put as more rows are drawn. *@
                <colgroup><col class="num-col" /><col class="cover-col" /><col /><col class="album-col hide-narrow" /><col class="length-col hide-narrow" /><col class="icons-4-col" /></colgroup>
                <thead>
                    <tr>
                        <th class="num">#</th>
                        <th class="cover-col"></th>
                        <th>Title</th>
                        <th class="hide-narrow">Album</th>
                        <th class="num hide-narrow">Length</th>
                        <th></th>
                    </tr>
                </thead>
                @* Only the rows near the screen are drawn; the rest are slots, which shimmer if they're scrolled to before they are. *@
                <tbody>
                    <Virtualize Items="Format.Indexed(_playlist.Songs)" Context="row" ItemSize="56" OverscanCount="15" SpacerElement="tr">
                        @{
                            var (song, index) = row;
                            var canPlay = song.State is PlaylistSongState.Library or PlaylistSongState.Local;
                            var albumHref = song.AlbumId is { } album ? $"{(song.State == PlaylistSongState.Local ? "local/albums" : "albums")}/{album}" : null;
                        }
                        <tr @key="song.EntryId" class="@(canPlay ? "" : "dim") @(canPlay && Player.Now is { } now && now.TrackId == (song.TrackId ?? song.FileId) ? "playing" : "") @Drag.Class(index)"
                            @ondragover="() => Drag.Over(index)" @ondragover:preventDefault="true"
                            @ondrop="() => Drag.DropAsync(index, MoveToAsync)" @ondrop:preventDefault="true">
                            <td class="num muted"><div class="drag-num"><DragHandle Disabled="_busy" OnStart="() => Drag.Start(index)" OnEnd="Drag.End" />@(index + 1)</div></td>
                            <td class="cover-col">
                                @if (albumHref is not null) { <a href="@albumHref" tabindex="-1"><Cover Url="@song.CoverUrl" /></a> } else { <Cover Url="@song.CoverUrl" /> }
                            </td>
                            <td class="track-main">
                                <div class="ellipsis">
                                    @if (song.State == PlaylistSongState.Library) { <a href="tracks/@song.TrackId" class="plain">@song.Title</a> } else { @song.Title }
                                </div>
                                <div class="muted small ellipsis">
                                    @if (song.ArtistId is { } artist) { <a class="muted" href="@(song.State == PlaylistSongState.Local ? "local/artists" : "artists")/@artist">@song.Artist</a> } else { @song.Artist }
                                    @switch (song.State)
                                    {
                                        case PlaylistSongState.ServerOnly when song.ReviewPath is { } path && Auth.May(UserPermissions.Review):
                                            <span> · only on the media server, </span><a href="@($"review?filter={Uri.EscapeDataString(path)}")" title="@path">waiting in Review</a>
                                            break;
                                        case PlaylistSongState.ServerOnly:
                                            <span> · only on the media server</span>
                                            break;
                                        case PlaylistSongState.Gone:
                                            <span> · no longer in your library</span>
                                            break;
                                        case PlaylistSongState.Awaiting:
                                            <span> · missing</span>
                                            break;
                                        case PlaylistSongState.Coming:
                                            <span> · on its way</span>
                                            break;
                                    }
                                </div>
                            </td>
                            <td class="hide-narrow muted small ellipsis">
                                @if (albumHref is not null) { <a class="muted" href="@albumHref">@song.AlbumTitle</a> } else { @song.AlbumTitle }
                            </td>
                            <td class="num hide-narrow muted">@Format.Duration(song.DurationSeconds)</td>
                            <td class="num actions">
                                <div class="row-actions">
                                    @if (canPlay)
                                    {
                                        <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="Play the playlist from here" OnClick="() => PlayFromAsync(song)" />
                                    }
                                    <ItemMenu Entry="@(canPlay ? PlaylistNames.Playable([song]).FirstOrDefault() : null)" Name="@song.Title"
                                              Keep="@(song.State == PlaylistSongState.Library && song.TrackId is { } kept ? [new PlaylistItem(kept)] : null)"
                                              UpgradeTrackId="@(song.State == PlaylistSongState.Library ? song.TrackId : null)" AlbumHref="@albumHref"
                                              Get="@(song.State == PlaylistSongState.Awaiting && song.TrackId is { } awaited ? (RequestKind.Track, awaited) : null)"
                                              ListenTrackId="@(song.State is PlaylistSongState.Awaiting or PlaylistSongState.Coming ? song.TrackId : null)"
                                              ArtistHref="@(song.ArtistId is { } artistId ? $"{(song.State == PlaylistSongState.Local ? "local/artists" : "artists")}/{artistId}" : null)"
                                              OnMove="by => MoveAsync(index, by)" MoveFirst="@(index == 0 || _busy)" MoveLast="@(index == _playlist.Songs.Count - 1 || _busy)"
                                              OnTakeOut="() => RemoveAsync(index)" TakeOutLabel="Take it out of the playlist" />
                                </div>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    }
}

@if (_renaming && _playlist is not null)
{
    <Dialog Title="Edit the playlist" OnClose="() => _renaming = false">
        <div class="field">
            <label class="field-label" for="playlist-rename">Name</label>
            <input id="playlist-rename" type="text" @bind="_name" @bind:event="oninput" />
            @if (Delimiter.Length > 0) { <span class="muted small">Folders are part of the name, split by @Delimiter, as in Moods@(Delimiter)Calm.</span> }
        </div>
        <div class="field">
            <label class="field-label" for="playlist-comment">Comment</label>
            <textarea id="playlist-comment" rows="3" @bind="_comment"></textarea>
        </div>
        <AddToTopField @bind-Value="_addToTop" />
        @if (_renameError is not null) { <p class="error small">@_renameError</p> }
        <div class="toolbar">
            <span class="spacer"></span>
            <button @onclick="() => _renaming = false">Cancel</button>
            <button class="primary" disabled="@(_busy || _name.Trim().Length == 0)" @onclick="RenameAsync">Save</button>
        </div>
    </Dialog>
}

@if (_deleting && _playlist is not null)
{
    <Dialog Title="@($"Delete {PlaylistNames.Leaf(_playlist.Playlist.Name, Delimiter)}?")" Alert="true" OnClose="() => _deleting = false">
        <p>
            The songs stay in your library.
            @if (_playlist.Playlist.Sync != PlaylistSyncState.Off) { <text>It's deleted from the media server too.</text> }
        </p>
        <div class="toolbar">
            <span class="spacer"></span>
            <button @onclick="() => _deleting = false">Keep it</button>
            <button class="danger" disabled="@_busy" @onclick="DeleteAsync">Delete</button>
        </div>
    </Dialog>
}

@if (_choosingCover && _playlist is not null)
{
    <PlaylistCoverDialog Playlist="_playlist.Playlist" Name="@PlaylistNames.Leaf(_playlist.Playlist.Name, Delimiter)" Synced="_playlist.Playlist.Sync != PlaylistSyncState.Off"
                         OnClose="() => _choosingCover = false" OnChanged="p => _playlist = _playlist with { Playlist = p }" />
}

@code {
    private bool _choosingCover;

    private async Task PinAsync()
    {
        var changed = await Api.PinPlaylistAsync(_playlist!.Playlist.Id, !_playlist.Playlist.Pinned);
        _playlist = _playlist with { Playlist = changed };
    }

    [Parameter] public Guid Id { get; set; }

    /// <summary>What a playlist's menu elsewhere asked to do here: edit, picture or delete.</summary>
    [SupplyParameterFromQuery(Name = "do")] public string? Do { get; set; }

    private PlaylistDetail? _playlist;
    private bool _notFound, _busy, _renaming, _deleting;

    private string _name = "";
    private string? _comment, _error, _renameError;
    private bool _addToTop;

    private string Delimiter => PlaylistNames.Delimiter(Auth);

    // Looks again a few times while it waits to sync, which happens a few seconds after a change.
    private Timer? _recheck;
    private int _rechecks;

    protected override async Task OnParametersSetAsync()
    {
        Player.Changed -= Redraw;
        Player.Changed += Redraw;
        ScanStatus.LibraryChanged -= Reload;
        ScanStatus.LibraryChanged += Reload;
        Tracker.Changed -= Redraw;
        Tracker.Changed += Redraw;
        await Task.WhenAll(LoadAsync(), Tracker.EnsureLoadedAsync());
        if (Do is { } asked && _playlist is not null)
        {
            switch (asked)
            {
                case "edit": StartRename(); break;
                case "picture": _choosingCover = true; break;
                case "delete": _deleting = true; break;
            }
            // Done once: back or a reload doesn't ask again.
            Nav.NavigateTo($"playlists/{Id}", replace: true);
        }
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private void Reload() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose()
    {
        Player.Changed -= Redraw;
        ScanStatus.LibraryChanged -= Reload;
        Tracker.Changed -= Redraw;
        _recheck?.Dispose();
    }

    private async Task LoadAsync()
    {
        _playlist = await Api.GetPlaylistAsync(Id);
        _notFound = _playlist is null;
        WatchSync();
    }

    private void WatchSync()
    {
        _recheck?.Dispose();
        _recheck = null;
        if (_playlist?.Playlist.Sync != PlaylistSyncState.Waiting || _rechecks >= 4)
            return;
        _rechecks++;
        _recheck = new Timer(_ => InvokeAsync(async () =>
        {
            if (await Api.GetPlaylistAsync(Id) is { } fresh && _playlist is not null)
                _playlist = _playlist with { Playlist = fresh.Playlist };
            WatchSync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(5), Timeout.InfiniteTimeSpan);
    }

    private Task PlayFromAsync(PlaylistSong from)
    {
        var playable = _playlist!.Songs.Where(s => s.State is PlaylistSongState.Library or PlaylistSongState.Local).ToList();
        return Player.PlayAsync(PlaylistNames.Playable(playable), playable.IndexOf(from), From);
    }

    // Songs played from here say so in your listening history.
    private PlaySource? From => _playlist is { } playlist ? new PlaySource(PlaySourceKind.Playlist, playlist.Playlist.Id, playlist.Playlist.Name) : null;

    // Songs an import put in that aren't in your library yet, nor asked for.
    private List<Guid> Awaiting => _playlist is null ? [] : _playlist.Songs
        .Where(s => s.State == PlaylistSongState.Awaiting && s.TrackId is not null && Tracker.Find(RequestKind.Track, s.TrackId.Value) is null)
        .Select(s => s.TrackId!.Value).Distinct().ToList();

    private async Task GetAwaitingAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            foreach (var track in Awaiting)
                await Tracker.CreateAsync(new CreateRequest(RequestKind.Track, track));
            await LoadAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }

    private readonly DragOrder Drag = new();

    private Task MoveToAsync(int from, int to) => MoveAsync(from, to - from);

    // A step up or down, or to the top or bottom.
    private Task MoveAsync(int index, int by)
    {
        var ids = _playlist!.Songs.Select(s => s.EntryId).ToList();
        var id = ids[index];
        ids.RemoveAt(index);
        ids.Insert(Math.Clamp(by is int.MinValue or int.MaxValue ? by : index + by, 0, ids.Count), id);
        return ArrangeAsync(ids);
    }

    private Task RemoveAsync(int index) => ArrangeAsync(_playlist!.Songs.Where((_, i) => i != index).Select(s => s.EntryId).ToList());

    private async Task ArrangeAsync(IReadOnlyList<Guid> ids)
    {
        _busy = true;
        _error = null;
        try
        {
            _playlist = await Api.ArrangePlaylistAsync(Id, new ArrangePlaylist(ids));
            _rechecks = 0;
            WatchSync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }

    private void StartRename()
    {
        _name = _playlist!.Playlist.Name;
        _comment = _playlist.Playlist.Comment;
        _addToTop = _playlist.Playlist.AddToTop;
        _renameError = null;
        _renaming = true;
    }

    private async Task RenameAsync()
    {
        _busy = true;
        _renameError = null;
        try
        {
            var summary = await Api.UpdatePlaylistAsync(Id, new UpdatePlaylist(_name.Trim(), _comment ?? "", _addToTop));
            _playlist = _playlist! with { Playlist = summary };
            _renaming = false;
            _rechecks = 0;
            WatchSync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _renameError = e.Message;
        }
        _busy = false;
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Api.DeletePlaylistAsync(Id);
            Nav.NavigateTo("playlists");
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
            _deleting = false;
        }
        _busy = false;
    }
}
