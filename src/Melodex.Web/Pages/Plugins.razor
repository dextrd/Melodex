@page "/settings/plugins"
@layout SettingsLayout
@using Melodex.Contracts.Plugins
@using Melodex.Contracts.Plugins.Connectors
@inject MelodexClient Api
@inject AuthState Auth

<SectionTitle>Plugins · Melodex</SectionTitle>

@if (!InSetup)
{
    <p class="muted">What Melodex works through: where music comes from, the media server it files music for, and the catalogue it checks your library against, with its pictures.</p>
}

@if (_plugins is null)
{
    <Loading />
}
else
{
    @if (_error is not null && _choosing is null && _editing is null && _removing is null && _switching is null) { <div class="notice error">@_error</div> }

    <div class="plugin-sections">
        @Section(PluginType.Retrieval, "Sources",
            "Retrieval plugins run in their own containers. A request searches them all at once, and fetches the best quality your quality profile allows of the right song, whichever has it.",
            "No sources yet, so nothing can be fetched. Add one to get started.")
        @Section(PluginType.Connector, "Media server",
            "Told to scan when music is filed, so it shows up there. One is used at a time: turning another on switches to it.",
            "No media server yet. Music is still filed, but nothing is told about it.")
        @Section(PluginType.Index, "Catalogue",
            "Where Melodex learns what each artist has released, to tell what's missing. The first is the core catalogue; the ones after it fill in what it doesn't have.",
            "No catalogue. Melodex is a plain music library, showing your files as their tags say: without one it can't tell what's missing, fetch music, or search for music you don't have.")
        @Section(PluginType.Artwork, "Artwork",
            "Pictures of artists and album covers. For each picture, Melodex asks these in order and keeps the first one found.",
            "No artwork sources, so artists and albums show placeholders.")
        @Section(PluginType.Lyrics, "Lyrics",
            "The words of songs, found for each song in your library after a scan and written beside or into its files. Melodex asks these in order and keeps the first lyrics found.",
            "No lyrics sources, so songs won't get lyrics.")
    </div>

    @if (_choosing is { } type)
    {
        <Dialog Title="@(_adding is { } a ? $"Add {(a.Key == Own ? "your own plugin" : a.Name)}" : $"Add to {SectionName(type)}")" OnClose="CloseAdd" Class="wide">
            @if (_error is not null) { <p class="error">@_error</p> }
            @if (_adding is { } adding)
            {
                @if (adding.BuiltIn is { Manifest.UsesSettingsOf: not null } borrower)
                {
                    <p class="muted">Uses the connection to @(Lender(borrower)?.Name ?? "the plugin it needs"), so there's nothing to set up.</p>
                }
                else if (adding.BuiltIn is { } builtIn)
                {
                    <SchemaForm @ref="_addForm" Schema="builtIn.Manifest.SettingsSchema" />
                }
                else
                {
                    @if (adding.Key == Own)
                    {
                        <p class="muted">A plugin that doesn't come with Melodex, running on its own, such as in a container of its own. It must speak
                            Melodex's @ContractName(type) contract: see <a href="settings/help/plugins#your-own-plugins">your own plugins</a> in the guide.
                            Only add plugins you trust: they're sent their settings, and what they answer goes into your library.</p>
                    }
                    <label class="field">
                        <span class="field-label">Address</span>
                        <input type="text" placeholder="http://my-plugin:8080" @bind="_endpoint" @bind:event="oninput" />
                        <span class="muted small">Where Melodex reaches the plugin. In the same Compose project, that's its service name and port.</span>
                    </label>
                }
                <div class="toolbar dialog-buttons">
                    <button @onclick="() => _adding = null">Back</button>
                    <button class="primary" disabled="@(_busy || adding.BuiltIn is null && string.IsNullOrWhiteSpace(_endpoint))" @onclick="AddAsync">
                        @if (_busy) { <span class="spinner"></span> }Add and test
                    </button>
                </div>
            }
            else
            {
                <div class="templates">
                    @if (!Templates(type).Any())
                    {
                        <p class="muted small">Nothing that comes with Melodex is left to add here.</p>
                    }
                    @foreach (var template in Templates(type))
                    {
                        var added = Added(template);
                        var needs = Needs(template);
                        <button class="template" disabled="@(added || needs is not null)" @onclick="() => Pick(template)">
                            <strong>@template.Name</strong>
                            <span class="muted small">@template.Description</span>
                            @if (added) { <span class="badge owned">Added</span> }
                            else if (needs is not null) { <span class="small plugin-message">Set up @needs as your media server first.</span> }
                            else if (template.Endpoint is { Length: > 0 } url) { <code class="small">@url</code> }
                        </button>
                    }
                </div>
                <div class="toolbar dialog-buttons">
                    <button class="link own-plugin" @onclick="() => Pick(OwnPlugin(type))">Add your own plugin…</button>
                    <span class="spacer"></span>
                    <button @onclick="CloseAdd">Cancel</button>
                </div>
            }
        </Dialog>
    }

    @if (_removing is { } removing)
    {
        <Dialog Title="@($"Remove {removing.Name}?")" OnClose="() => _removing = null" Alert="true">
            @if (_error is not null) { <p class="error">@_error</p> }
            <p>Its settings are forgotten. You can add it again later.</p>
            @if (removing.Type == PluginType.Connector)
            {
                <p>Everyone's login for it is forgotten too.@(removing.Enabled ? " It's the media server in use: with none on, music is still filed, but no server is told about it and playlists stop syncing." : "")</p>
            }
            @if (removing.Type == PluginType.Index && _plugins.Count(p => p.Type == PluginType.Index) == 1)
            {
                <p>It's your only catalogue. Without one, Melodex is a plain music library: new files show as their tags say, and
                    missing music, fetching and searching for music you don't have stop working until you add one.</p>
            }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _removing = null">Cancel</button>
                <button class="danger" disabled="@_busy" @onclick="() => RemoveAsync(removing)">Remove</button>
            </div>
        </Dialog>
    }

    @if (_switching is { } switching)
    {
        var current = _plugins.FirstOrDefault(p => p.Type == PluginType.Connector && p.Enabled && p.Id != switching.Id);
        <Dialog Title="@(current is null ? $"Turn {switching.Name} off?" : $"Switch to {switching.Name}?")" OnClose="() => _switching = null" Alert="true">
            @if (_error is not null) { <p class="error">@_error</p> }
            @if (current is null)
            {
                <p>It's the media server in use. With none on, music is still filed, but no server is told about it and playlists stop syncing.</p>
            }
            else
            {
                <p>@current.Name is the media server now. Turning @switching.Name on turns @current.Name off: only one is used at a time.</p>
                <p>Melodex finds your songs again on @switching.Name, and from then on tells it about new music.</p>
                @if (switching.Manifest?.Capabilities.Contains(ConnectorCapabilities.UserPlaylists) == true)
                {
                    <p>Playlists sync with @switching.Name once each person links their login for it, under their account. Logins for
                        @current.Name are kept, for switching back.</p>
                }
                else
                {
                    <p>Playlists stay in Melodex but don't sync with @switching.Name. Logins for @current.Name are kept, for switching back.</p>
                }
            }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _switching = null">Cancel</button>
                <button class="@(current is null ? "danger" : "primary")" disabled="@_busy" @onclick="() => SwitchAsync(switching)">
                    @if (_busy) { <span class="spinner"></span> }@(current is null ? "Turn off" : $"Switch to {switching.Name}")
                </button>
            </div>
        </Dialog>
    }

    @if (_editing is { } editingId && _plugins.FirstOrDefault(p => p.Id == editingId) is { } editing)
    {
        <Dialog Title="@($"{editing.Name} settings")" OnClose="() => _editing = null" Class="wide">
            @if (_error is not null) { <p class="error">@_error</p> }
            <SchemaForm @ref="_editForm" Schema="editing.Manifest?.SettingsSchema" Settings="editing.Settings" HasSaved="true" />
            @foreach (var check in editing.Manifest?.Checks ?? [])
            {
                <div class="field">
                    <button disabled="@(_checking is not null)" @onclick="() => CheckAsync(editing, check.Id)">
                        @if (_checking == check.Id) { <span class="spinner"></span> }@check.Title
                    </button>
                    @if (check.Description is not null) { <div class="muted small">@check.Description</div> }
                    @if (_checks.TryGetValue(check.Id, out var found))
                    {
                        <div class="notice @(found.Passed ? "passed" : "warning")"><LinkedText Value="@found.Message" /></div>
                    }
                </div>
            }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _editing = null">Cancel</button>
                <button class="primary" disabled="@_busy" @onclick="() => SaveAsync(editing)">
                    @if (_busy) { <span class="spinner"></span> }Save and test
                </button>
            </div>
        </Dialog>
    }
}

@code {
    /// <summary>Something that can be added: a retrieval plugin Melodex knows the usual address of, any other by its address, or a built-in plugin.</summary>
    public sealed record Template(string Key, string Name, string Description, PluginType Type, string? Endpoint = null, AvailablePlugin? BuiltIn = null);

    // The retrieval plugins that ship alongside Melodex, at the addresses the Compose file gives them.
    public static readonly Template[] KnownSources =
    [
        new("ytdlp", "YouTube (yt-dlp)", "Finds songs and albums on YouTube Music and downloads the audio.", PluginType.Retrieval, "http://retriever-ytdlp:8080"),
        new("archive", "Internet Archive", "Finds concerts in the Live Music Archive and netlabel releases, and downloads them in FLAC where there is one.", PluginType.Retrieval, "http://retriever-archive:8080"),
        new("prowlarr", "Prowlarr", "Searches the torrent indexers you've set up in Prowlarr and downloads with your qBittorrent.", PluginType.Retrieval, "http://retriever-prowlarr:8080"),
        new("qobuz", "Qobuz", "Downloads from Qobuz with your own subscription, in FLAC up to 24-bit/192 kHz.", PluginType.Retrieval, "http://retriever-qobuz:8080"),
        new("tidal", "Tidal", "Downloads from Tidal with your own subscription, in FLAC up to 24-bit/192 kHz.", PluginType.Retrieval, "http://retriever-tidal:8080"),
        new("bandcamp", "Bandcamp", "Downloads albums and songs you've bought on Bandcamp, in FLAC or another format it offers.", PluginType.Retrieval, "http://retriever-bandcamp:8080"),
        new("inbox", "Inbox folder", "Offers audio files you drop into a folder, matched to requests by their tags.", PluginType.Retrieval, "http://retriever-inbox:8080"),
    ];

    private const string Own = "own";

    /// <summary>A plugin that doesn't come with Melodex, of the section's kind, by its address.</summary>
    private static Template OwnPlugin(PluginType type) => new(Own, "Your own plugin", "", type, "");

    private static string ContractName(PluginType type) => type switch
    {
        PluginType.Retrieval => "retrieval",
        PluginType.Connector => "media server",
        PluginType.Index => "catalogue",
        PluginType.Lyrics => "lyrics",
        _ => "artwork",
    };

    private IReadOnlyList<PluginInfo>? _plugins;
    private IReadOnlyList<AvailablePlugin> _available = [];
    private string? _error;
    private bool _busy;

    private Guid? _editing;
    private string? _checking;
    private readonly Dictionary<string, PluginCheckResult> _checks = [];
    /// <summary>Shown in the first run's setup, which says what plugins are itself.</summary>
    [Parameter] public bool InSetup { get; set; }

    private PluginInfo? _removing;
    private readonly HashSet<Guid> _expanded = [];

    private void ToggleExpanded(PluginInfo plugin)
    {
        if (!_expanded.Remove(plugin.Id))
            _expanded.Add(plugin.Id);
    }

    private void ToggleOnKey(KeyboardEventArgs e, PluginInfo plugin)
    {
        if (e.Key is "Enter" or " ")
            ToggleExpanded(plugin);
    }
    private SchemaForm? _editForm;

    // Adding: the section whose templates are showing, then the template being filled in.
    private PluginType? _choosing;
    private Template? _adding;
    private string _endpoint = "";
    private SchemaForm? _addForm;

    private IEnumerable<PluginInfo> OfType(PluginType type) => _plugins!.Where(p => p.Type == type).OrderBy(p => p.Priority);

    protected override async Task OnInitializedAsync()
    {
        _available = await Api.ListAvailablePluginsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _plugins = await Api.ListPluginsAsync();

    private IEnumerable<Template> Templates(PluginType type) => type == PluginType.Retrieval
        ? KnownSources
        : _available.Where(a => a.Manifest.Type == type && a.Problem is null)
            .Select(a => new Template(a.Manifest.Id, a.Manifest.Name, a.Manifest.Description ?? "", type, BuiltIn: a));

    /// <summary>The plugin whose connection a plugin borrows, if it's set up.</summary>
    private PluginInfo? Lender(AvailablePlugin plugin) =>
        plugin.Manifest.UsesSettingsOf is { } lender ? _plugins!.Where(p => p.PluginId == lender).MinBy(p => p.Priority) : null;

    /// <summary>The name of the plugin to set up first, when a template borrows its connection and it isn't set up.</summary>
    private string? Needs(Template template) =>
        template.BuiltIn is { Manifest.UsesSettingsOf: { } lender } builtIn && Lender(builtIn) is null
            ? _available.FirstOrDefault(a => a.Manifest.Id == lender)?.Manifest.Name ?? lender
            : null;

    /// <summary>Already set up: a source at the same address, or the same built-in plugin.</summary>
    private bool Added(Template template) => template.BuiltIn is { } builtIn
        ? _plugins!.Any(p => p.PluginId == builtIn.Manifest.Id)
        : template.Endpoint is { Length: > 0 } url && _plugins!.Any(p => string.Equals(p.Endpoint, url.TrimEnd('/'), StringComparison.OrdinalIgnoreCase));

    private static string SectionName(PluginType type) => type switch
    {
        PluginType.Retrieval => "Sources",
        PluginType.Connector => "Media server",
        PluginType.Index => "Catalogue",
        PluginType.Lyrics => "Lyrics",
        _ => "Artwork",
    };

    // Sources aren't: every one is searched, and the quality profile chooses between them.
    private static bool Ordered(PluginType type) => type is PluginType.Artwork or PluginType.Lyrics or PluginType.Index;

    private RenderFragment Section(PluginType type, string title, string about, string empty) => __builder =>
    {
        var plugins = OfType(type).ToList();
        <section class="panel plugin-section" aria-label="@title">
            <header class="panel-head">
                <div class="panel-title">
                    <h2>@title</h2>
                    <p class="muted small">@about</p>
                </div>
                <button class="primary small" @onclick="() => Choose(type)">Add</button>
            </header>
            @if (plugins.Count == 0)
            {
                <div class="panel-empty muted small">@empty</div>
            }
            else
            {
                <div class="plugin-grid">
                    @foreach (var plugin in plugins)
                    {
                        @Card(plugin, plugins)
                    }
                </div>
            }
        </section>
    };

    private RenderFragment Card(PluginInfo plugin, List<PluginInfo> list) => __builder =>
    {
        var index = list.IndexOf(plugin);
        var problem = plugin.HealthMessage is not null && plugin.Health != HealthStatus.Healthy ? plugin.HealthMessage : null;
        var expanded = _expanded.Contains(plugin.Id);
        <div class="plugin-card @(plugin.Enabled ? "" : "off") @(expanded ? "open" : "")">
            <div class="plugin-top">
                @if (Ordered(plugin.Type) && list.Count > 1)
                {
                    <span class="plugin-order" title="Asked @(Ordinal(index + 1))">@(index + 1)</span>
                }
                <strong class="ellipsis" title="@plugin.Name">@plugin.Name</strong>
                <span class="spacer"></span>
                @if (plugin.Enabled)
                {
                    <span class="badge @HealthBadge(plugin.Health)" title="@plugin.HealthMessage">@HealthLabel(plugin.Health)</span>
                }
                else
                {
                    <span class="badge neutral">Off</span>
                }
            </div>
            @* Two lines each, so the cards line up; a click or tap shows the rest. *@
            <div class="muted small plugin-about" title="@(expanded ? null : plugin.Endpoint ?? plugin.Manifest?.Description)" role="button" tabindex="0"
                 aria-expanded="@(expanded ? "true" : "false")" @onclick="() => ToggleExpanded(plugin)"
                 @onkeydown="e => ToggleOnKey(e, plugin)">
                @(plugin.Endpoint ?? plugin.Manifest?.Description)@(plugin.Manifest is { } m ? $" · v{m.Version}" : "")
            </div>
            <div class="small plugin-message" title="@(expanded ? null : problem)" @onclick="() => ToggleExpanded(plugin)"><LinkedText Value="@problem" /></div>
            <div class="plugin-actions">
                @if (Ordered(plugin.Type) && list.Count > 1)
                {
                    <IconButton Icon="up" Title="Ask earlier" Disabled="@(_busy || index == 0)" OnClick="() => MoveAsync(plugin, -1)" />
                    <IconButton Icon="down" Title="Ask later" Disabled="@(_busy || index == list.Count - 1)" OnClick="() => MoveAsync(plugin, 1)" />
                }
                <span class="spacer"></span>
                <IconButton Icon="power" On="plugin.Enabled" Title="@(plugin.Enabled ? "On: click to turn it off" : "Off: click to turn it on")"
                            Disabled="_busy" OnClick="() => ToggleAsync(plugin)" />
                <IconButton Icon="test" Title="Test the connection" Disabled="_busy" OnClick="() => TestAsync(plugin)" />
                @if (plugin.Manifest is not { UsesSettingsOf: not null })
                {
                    <IconButton Icon="settings" Title="Settings" OnClick="() => Edit(plugin)" />
                }
                <IconButton Icon="remove" Class="remove" Title="Remove" Disabled="_busy" OnClick="() => _removing = plugin" />
            </div>
        </div>
    };

    private static string Ordinal(int n) => n switch { 1 => "first", 2 => "second", 3 => "third", _ => $"{n}th" };

    private void Edit(PluginInfo plugin)
    {
        _editing = plugin.Id;
        _error = null;
        _checks.Clear();
    }

    // A check runs with the settings as they are in the form, so a change can be tried before it's saved.
    private async Task CheckAsync(PluginInfo plugin, string check)
    {
        _checking = check;
        try
        {
            _checks[check] = await Api.RunPluginCheckAsync(plugin.Id, check, new RunPluginCheck(_editForm!.ToJson()));
        }
        catch (Exception e) when (e is MelodexApiException or HttpRequestException)
        {
            _checks[check] = new PluginCheckResult(false, $"Couldn't check: {e.Message}");
        }
        finally
        {
            _checking = null;
        }
    }

    private void CloseAdd()
    {
        _choosing = null;
        _adding = null;
        _error = null;
    }

    private void Choose(PluginType type)
    {
        _choosing = type;
        _adding = null;
        _error = null;
    }

    private void Pick(Template template)
    {
        _adding = template;
        _endpoint = template.Endpoint ?? "";
    }

    private Task AddAsync() => RunAsync(async () =>
    {
        var adding = _adding!;
        var added = adding.BuiltIn is { } builtIn
            ? await Api.AddPluginAsync(new AddPlugin(PluginId: builtIn.Manifest.Id, Settings: builtIn.Manifest.UsesSettingsOf is null ? _addForm!.ToJson() : null))
            : await Api.AddPluginAsync(new AddPlugin(Endpoint: _endpoint.Trim(), Type: adding.Type));
        _adding = null;
        _choosing = null;
        await Api.TestPluginAsync(added.Id);
    });

    private Task SaveAsync(PluginInfo plugin) => RunAsync(async () =>
    {
        await Api.UpdatePluginAsync(plugin.Id, new UpdatePlugin(Settings: _editForm!.ToJson()));
        _editing = null;
        await Api.TestPluginAsync(plugin.Id);
    });

    private Task TestAsync(PluginInfo plugin) => RunAsync(() => Api.TestPluginAsync(plugin.Id));

    private Task SetEnabledAsync(PluginInfo plugin, bool enabled) => RunAsync(() => Api.UpdatePluginAsync(plugin.Id, new UpdatePlugin(Enabled: enabled)));

    // A media server being switched to, or the one in use being turned off, asked about first.
    private PluginInfo? _switching;

    private Task ToggleAsync(PluginInfo plugin)
    {
        var others = _plugins!.Any(p => p.Type == PluginType.Connector && p.Enabled && p.Id != plugin.Id);
        if (plugin.Type == PluginType.Connector && (plugin.Enabled ? !others : others))
        {
            _error = null;
            _switching = plugin;
            return Task.CompletedTask;
        }
        return SetEnabledAsync(plugin, !plugin.Enabled);
    }

    private Task SwitchAsync(PluginInfo plugin) => RunAsync(async () =>
    {
        await Api.UpdatePluginAsync(plugin.Id, new UpdatePlugin(Enabled: !plugin.Enabled));
        _switching = null;
    });

    private Task RemoveAsync(PluginInfo plugin) => RunAsync(async () =>
    {
        await Api.RemovePluginAsync(plugin.Id);
        _removing = null;
    });

    private Task MoveAsync(PluginInfo plugin, int by) => RunAsync(() =>
    {
        var order = OfType(plugin.Type).Select(p => p.Id).ToList();
        var from = order.IndexOf(plugin.Id);
        order.RemoveAt(from);
        order.Insert(from + by, plugin.Id);
        return Api.OrderPluginsAsync(order);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
        // Whether there's a catalogue changes what the rest of the app offers.
        if (_plugins is not null && Auth.Status is { } status && status.Catalogue != _plugins.Any(p => p.Type == PluginType.Index && p.Enabled))
            Auth.Set(await Api.GetAuthStatusAsync());
        _busy = false;
    }

    private static string HealthBadge(HealthStatus? health) => health switch
    {
        HealthStatus.Healthy => "owned",
        HealthStatus.Degraded => "partial",
        HealthStatus.Unhealthy => "missing",
        _ => "neutral",
    };

    private static string HealthLabel(HealthStatus? health) => health switch
    {
        HealthStatus.Healthy => "Working",
        HealthStatus.Degraded => "Partly working",
        HealthStatus.Unhealthy => "Not working",
        _ => "Not tested",
    };
}
