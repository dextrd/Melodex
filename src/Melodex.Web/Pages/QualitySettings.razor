@page "/settings/quality"
@layout SettingsLayout
@inject MelodexClient Api

<PageTitle>Quality · Settings · Melodex</PageTitle>

@if (_steps is null || _profile is null)
{
    <Loading />
}
else
{
    <h2>Quality profile</h2>
    <p class="muted small">
        Every source is searched at once, and of the candidates that are the right song, the one highest in this list is fetched: a likelier match
        always comes before a better quality of what may be the wrong recording. Qualities turned off are never kept; a file's quality is read once
        it's here, so one that was said to be better than it is gets refused.
    </p>

    <div class="card settings-card">
        <div class="setting-line">
            Good enough at
            <select @bind="Cutoff" aria-label="Cutoff">
                @foreach (var (step, allowed) in _steps.Where(s => s.Allowed))
                {
                    <option value="@step.Key">@step.Name</option>
                }
            </select>
            and above
        </div>
        <div class="muted small">
            Music at or above the cutoff isn't upgraded. Artists, albums and songs can have their own, or never be upgraded, from their pages.
        </div>
        <div class="setting-line">
            Listen now aims for
            <select @bind="ListenTarget" aria-label="Listen now target">
                @foreach (var (step, _) in _steps)
                {
                    <option value="@step.Key">@step.Name</option>
                }
            </select>
        </div>
        <div class="muted small">
            A song you listen to without adding is fetched at this quality or the best under it, so it starts soon; if nothing is, the smallest above it.
            Added to the library, it's kept if the profile allows its quality, and fetched again if not.
        </div>
    </div>

    <h2>Lossless that seems lossy</h2>
    <p class="muted small">
        Lossy music is sometimes passed off as lossless: an MP3 saved as FLAC, labelled FLAC, but no better than the MP3. Lossy encoders cut off the highs
        where they give themselves away, about 16.5 kHz for an MP3 at 128 kbps and 20 kHz at 320, so each lossless download, and the library's lossless
        files, are checked for that. One that's cut off counts as what it seems to be. It's a suspicion, not proof: a master can be cut off on purpose, and an
        encode that keeps the highs can't be told.
    </p>
    <div class="card settings-card">
        @foreach (var (value, label, help) in SuspectOptions)
        {
            <label class="dialog-choice">
                <input type="radio" name="suspect" checked="@(_profile.Suspect == value)" @onchange="() => { _profile = _profile with { Suspect = value }; _saved = false; }" />
                <span><strong>@label</strong><span class="muted small">@help</span></span>
            </label>
        }
    </div>

    <ol class="quality-steps card" aria-label="Qualities, best first">
        @for (var i = 0; i < _steps.Count; i++)
        {
            var index = i;
            var (step, allowed) = _steps[i];
            @if (i == 0 || _steps[i - 1].Step.Level != step.Level)
            {
                <li class="quality-level muted small" aria-hidden="true">@LevelHeading(step.Level)</li>
            }
            <li class="quality-step @(allowed ? "" : "off") @(index > CutoffIndex ? "under" : "")">
                <label>
                    <input type="checkbox" checked="@allowed" @onchange="e => SetAllowed(index, (bool)e.Value!)" />
                    <span>@step.Name</span>
                </label>
                @if (step.Key == _profile.Cutoff)
                {
                    <span class="badge owned small">Cutoff</span>
                }
                @if (step.Key == _profile.ListenTarget)
                {
                    <span class="badge neutral small">Listen now</span>
                }
                <span class="spacer"></span>
                <IconButton Icon="up" Title="Prefer it" Disabled="@(index == 0)" OnClick="() => Move(index, -1)" />
                <IconButton Icon="down" Title="Prefer it less" Disabled="@(index == _steps.Count - 1)" OnClick="() => Move(index, 1)" />
            </li>
        }
    </ol>

    <div class="toolbar">
        <button class="primary" @onclick="SaveAsync">Save</button>
        <button @onclick="Reset">Use the default</button>
        @if (_saved) { <span class="muted small">Saved.</span> }
        @if (_saveError is not null) { <span class="error small" title="@_saveError">@_saveError</span> }
    </div>

    <h2>The library's lossless files</h2>
    @if (_spectra is { } spectra)
    {
        <div class="card settings-card">
            <div class="setting-line">
                @if (spectra.Lossless == 0)
                {
                    <span>There are no FLAC, WAV or AIFF files in the library to check.</span>
                }
                else
                {
                    <span>
                        @spectra.Checked of @spectra.Lossless checked;
                        @(spectra.Suspects.Count == 0 ? "none seem lossy" : spectra.Suspects.Count == 1 ? "1 seems lossy" : $"{spectra.Suspects.Count} seem lossy").
                    </span>
                    <span class="spacer"></span>
                    @if (spectra.Checked < spectra.Lossless)
                    {
                        <button @onclick="() => CheckAsync(false)" disabled="@_checking">Check the rest</button>
                    }
                    <button @onclick="() => CheckAsync(true)" disabled="@_checking">Check them all again</button>
                }
            </div>
            <div class="muted small">
                Files are only read. New and changed ones are checked after each scan; ALAC, APE and WavPack can't be.
                @if (_checkQueued) { <span>Queued: it's under Tasks in Activity.</span> }
            </div>
            @if (spectra.Suspects.Count > 0)
            {
                <ul class="suspect-files small">
                    @foreach (var file in spectra.Suspects.Take(_showAll ? int.MaxValue : 20))
                    {
                        <li>
                            <QualityBadge Quality="file.Quality" Dot="true" />
                            @if (file.TrackId is { } track)
                            {
                                <a href="/tracks/@track">@file.Path</a>
                            }
                            else
                            {
                                <span>@file.Path</span>
                            }
                            <span class="muted">· @file.Quality.Details</span>
                        </li>
                    }
                </ul>
                @if (!_showAll && spectra.Suspects.Count > 20)
                {
                    <button class="link" @onclick="() => _showAll = true">Show all @spectra.Suspects.Count</button>
                }
            }
        </div>
    }
}

@code {
    private QualityProfile? _profile;
    private List<(QualityStep Step, bool Allowed)>? _steps;
    private bool _saved;
    private string? _saveError;

    private SpectrumStatus? _spectra;
    private bool _checking, _checkQueued, _showAll;

    private static readonly (SuspectLossless Value, string Label, string Help)[] SuspectOptions =
    [
        (SuspectLossless.Refuse, "Refuse it", "It's left in staging, for the review list, and the next candidate is tried."),
        (SuspectLossless.Keep, "Keep it as what it seems", "It's filed if the profile allows the quality it seems to be, and counts as that, below the cutoff, for upgrades."),
    ];

    protected override async Task OnInitializedAsync()
    {
        _profile = await Api.GetQualityProfileAsync();
        _steps = _profile.Ordered().ToList();
        try
        {
            _spectra = await Api.GetSpectrumStatusAsync();
        }
        catch (HttpRequestException)
        {
            // Shown without it.
        }
    }

    private async Task CheckAsync(bool again)
    {
        _checking = true;
        try
        {
            await Api.CheckSpectraAsync(again);
            _checkQueued = true;
            _spectra = await Api.GetSpectrumStatusAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _saveError = e.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private string Cutoff
    {
        get => _profile!.Cutoff;
        set { _profile = _profile! with { Cutoff = value }; _saved = false; }
    }

    private string ListenTarget
    {
        get => _profile!.ListenTarget;
        set { _profile = _profile! with { ListenTarget = value }; _saved = false; }
    }

    private int CutoffIndex => _steps!.FindIndex(s => s.Step.Key == _profile!.Cutoff);

    private static string LevelHeading(QualityLevel level) => level switch
    {
        QualityLevel.HiRes => "Hi-res lossless: more than 16 bits or 48 kHz",
        QualityLevel.Lossless => "Lossless at CD quality",
        QualityLevel.High => "Lossy, high: about MP3 at 320 kbps",
        QualityLevel.Good => "Lossy, good: about MP3 V0",
        QualityLevel.Fair => "Lossy, fair: about MP3 at 160 to 220 kbps",
        _ => "Lossy, low: under about MP3 at 160 kbps",
    };

    private void SetAllowed(int index, bool allowed)
    {
        _steps![index] = (_steps[index].Step, allowed);
        // The cutoff has to be one that's wanted: turned off, it moves to the next one up that is.
        if (!allowed && _steps[index].Step.Key == _profile!.Cutoff
            && _steps.Take(index).LastOrDefault(s => s.Allowed) is { Step: var up } && up != default)
            _profile = _profile with { Cutoff = up.Key };
        _saved = false;
    }

    private void Move(int index, int by)
    {
        (_steps![index], _steps[index + by]) = (_steps[index + by], _steps[index]);
        _saved = false;
    }

    private void Reset()
    {
        _profile = new QualityProfile();
        _steps = _profile.Ordered().ToList();
        _saved = false;
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _saveError = null;
        try
        {
            await Api.SaveQualityProfileAsync(_profile! with { Steps = _steps!.Select(s => new ProfileStep(s.Step.Key, s.Allowed)).ToList() });
            _saved = true;
        }
        catch (MelodexApiException e)
        {
            _saveError = e.Message;
        }
    }
}
