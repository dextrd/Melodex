@page "/settings/quality"
@layout SettingsLayout
@inject MelodexClient Api

<PageTitle>Quality · Settings · Melodex</PageTitle>

@if (_steps is null || _profile is null)
{
    <Loading />
}
else
{
    <h2>Quality profile</h2>
    <p class="muted small">
        Every source is searched at once, and of the candidates that are the right song, the one highest in this list is fetched: a likelier match
        always comes before a better quality of what may be the wrong recording. Qualities turned off are never kept; a file's quality is read once
        it's here, so one that was said to be better than it is gets refused.
    </p>

    <div class="card settings-card">
        <div class="setting-line">
            Good enough at
            <select @bind="Cutoff" aria-label="Cutoff">
                @foreach (var (step, allowed) in _steps.Where(s => s.Allowed))
                {
                    <option value="@step.Key">@step.Name</option>
                }
            </select>
            and above
        </div>
        <div class="muted small">
            Music at or above the cutoff isn't upgraded. Artists, albums and songs can have their own, or never be upgraded, from their pages.
        </div>
        <div class="setting-line">
            Listen now aims for
            <select @bind="ListenTarget" aria-label="Listen now target">
                @foreach (var (step, _) in _steps)
                {
                    <option value="@step.Key">@step.Name</option>
                }
            </select>
        </div>
        <div class="muted small">
            A song you listen to without adding is fetched at this quality or the best under it, so it starts soon; if nothing is, the smallest above it.
            Added to the library, it's kept if the profile allows its quality, and fetched again if not.
        </div>
    </div>

    <h3 class="section">
        <button class="section-toggle" aria-expanded="@(_stepsOpen ? "true" : "false")" @onclick="() => _stepsOpen = !_stepsOpen">
            <span class="chevron @(_stepsOpen ? "open" : "")" aria-hidden="true"></span>
            Qualities, best first <span class="muted small">(@_steps.Count(s => s.Allowed) of @_steps.Count kept)</span>
        </button>
    </h3>
    @if (_stepsOpen)
    {
        <ol class="quality-steps card" aria-label="Qualities, best first">
            @for (var i = 0; i < _steps.Count; i++)
            {
                var index = i;
                var (step, allowed) = _steps[i];
                @if (i == 0 || _steps[i - 1].Step.Level != step.Level)
                {
                    <li class="quality-level muted small" aria-hidden="true">@LevelHeading(step.Level)</li>
                }
                <li class="quality-step @(allowed ? "" : "off") @(index > CutoffIndex ? "under" : "")">
                    <label>
                        <input type="checkbox" checked="@allowed" @onchange="e => SetAllowed(index, (bool)e.Value!)" />
                        <span>@step.Name</span>
                    </label>
                    @if (step.Key == _profile.Cutoff)
                    {
                        <span class="badge owned small">Cutoff</span>
                    }
                    @if (step.Key == _profile.ListenTarget)
                    {
                        <span class="badge neutral small">Listen now</span>
                    }
                    <span class="spacer"></span>
                    <IconButton Icon="up" Title="Prefer it" Disabled="@(index == 0)" OnClick="() => Move(index, -1)" />
                    <IconButton Icon="down" Title="Prefer it less" Disabled="@(index == _steps.Count - 1)" OnClick="() => Move(index, 1)" />
                </li>
            }
        </ol>
    }

    <h2>Lossless that seems lossy</h2>
    <p class="muted small">
        Lossy music is sometimes passed off as lossless: an MP3 saved as FLAC, labelled FLAC, but no better than the MP3. Lossy encoders cut off the highs
        where they give themselves away, about 16.5 kHz for an MP3 at 128 kbps and 20 kHz at 320, so each lossless download, and the library's lossless
        files, are checked for that. One that's cut off counts as what it seems to be. It's a suspicion, not proof: a master can be cut off on purpose, and an
        encode that keeps the highs can't be told.
    </p>
    <div class="card settings-card">
        @foreach (var (value, label, help) in SuspectOptions)
        {
            <label class="dialog-choice">
                <input type="radio" name="suspect" checked="@(_profile.Suspect == value)" @onchange="() => { _profile = _profile with { Suspect = value }; _saved = false; }" />
                <span><strong>@label</strong><span class="muted small">@help</span></span>
            </label>
        }
    </div>

    <div class="toolbar">
        <button class="primary" @onclick="SaveAsync">Save</button>
        <button @onclick="Reset">Use the default</button>
        @if (_saved) { <span class="muted small">Saved.</span> }
        @if (_saveError is not null) { <span class="error small" title="@_saveError">@_saveError</span> }
    </div>

    <h3>The library's lossless files</h3>
    @if (_spectra is { } spectra)
    {
        <div class="card settings-card">
            <div class="setting-line">
                @if (spectra.Lossless == 0)
                {
                    <span>There are no FLAC, WAV or AIFF files in the library to check.</span>
                }
                else
                {
                    <span>
                        @spectra.Checked of @spectra.Lossless checked;
                        @(spectra.Suspects.Count == 0 ? "none seem lossy" : spectra.Suspects.Count == 1 ? "1 seems lossy" : $"{spectra.Suspects.Count} seem lossy").
                    </span>
                    <span class="spacer"></span>
                    @if (spectra.Checked < spectra.Lossless)
                    {
                        <button @onclick="() => CheckAsync(false)" disabled="@_checking">Check the rest</button>
                    }
                    <button @onclick="() => CheckAsync(true)" disabled="@_checking">Check them all again</button>
                }
            </div>
            <div class="muted small">
                Files are only read. New and changed ones are checked after each scan; ALAC, APE and WavPack can't be.
                @if (_checkQueued) { <span>Queued: it's under Tasks in Activity.</span> }
            </div>
            @if (spectra.Suspects.Count > 0)
            {
                <div class="small">
                    @(spectra.Suspects.Count == 1 ? "It's" : "They're") under <a href="review/seems-lossy">Review → Seems lossy</a>, to replace or trust.
                </div>
            }
        </div>
    }

    <h2 id="upgrades">Upgrades</h2>
    <p class="muted small">
        A song below its cutoff is upgraded when a better copy is found: one whose quality, read once it's here and checked for lossy music passed off
        as lossless, is higher in the list above. It takes the old file's place, at its path with its own extension and with exactly the old file's tags,
        so the app you listen with sees the same song in a better file. Songs are upgraded one at a time, so an album can be of mixed quality for a while.
        Only matched files are, not deferred, excluded or hidden ones.
    </p>
    @if (_upgrades is { } upgrades)
    {
        @if (upgrades.Warning is { } warning)
        {
            <div class="notice warning" role="status">⚠ @warning</div>
        }
        <div class="card settings-card">
            <label class="setting-line">
                <input type="checkbox" checked="@_upgradeSettings!.Scheduled" @onchange="e => SetUpgrades(_upgradeSettings with { Scheduled = (bool)e.Value! })" />
                Look through the whole library for upgrades on a schedule
            </label>
            @if (_upgradeSettings.Scheduled)
            {
                <div class="setting-line" role="group" aria-label="Days">
                    On
                    <span class="day-toggles">
                        @foreach (var day in Week)
                        {
                            var on = _upgradeSettings.Days.Contains(day);
                            <button type="button" class="day-toggle @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" title="@day"
                                    @onclick="() => ToggleDay(day)">@day.ToString()[..3]</button>
                        }
                    </span>
                </div>
                <div class="setting-line">
                    Between
                    <input type="time" aria-label="From" value="@_upgradeSettings.From.ToString("HH:mm")"
                           @onchange="e => SetTime(e.Value, t => _upgradeSettings with { From = t })" />
                    and
                    <input type="time" aria-label="Until" value="@_upgradeSettings.Until.ToString("HH:mm")"
                           @onchange="e => SetTime(e.Value, t => _upgradeSettings with { Until = t })" />
                    @if (_upgradeSettings.Until <= _upgradeSettings.From)
                    {
                        <span class="muted small">the next day</span>
                    }
                </div>
                <div class="setting-line">
                    @if (_upgradeSettings.PerRun is { } most)
                    {
                        <span>Asking for at most</span>
                        <NumberField Value="most" Min="1" Max="500" Label="Songs each time" ValueChanged="n => SetUpgrades(_upgradeSettings with { PerRun = n })" />
                        <span>songs each time</span>
                    }
                    else
                    {
                        <span>Asking for as many songs as there's time for</span>
                    }
                    <label class="small">
                        <input type="checkbox" checked="@(_upgradeSettings.PerRun is null)"
                               @onchange="e => SetUpgrades(_upgradeSettings with { PerRun = (bool)e.Value! ? null : 25 })" />
                        No limit
                    </label>
                </div>
                <div class="muted small">
                    In the window, a few songs are looked for at a time, as many as fetches run at once, more as each finishes, until the limit, the
                    last song or the end of the window; any not started by then wait for the next. Those looked for longest ago come first, and
                    the worst of those. Each is a request on the Activity page, after anything asked for by hand; one that finds nothing better just
                    stays as it is. Times are in @(_upgradeSettings.TimeZone)@(_upgradeSettings.TimeZone == BrowserZone ? ", this browser's" : "").
                    @if (upgrades.Running)
                    {
                        <span>Looking now.</span>
                    }
                    else if (upgrades.NextRun is { } next)
                    {
                        <span>Next: @next.ToLocalTime().ToString("dddd d MMMM, HH:mm").</span>
                    }
                </div>
            }
            @foreach (var (value, label) in OldFileOptions)
            {
                <label class="dialog-choice">
                    <input type="radio" name="old-files" checked="@(_upgradeSettings.OldFiles == value)"
                           @onchange="() => SetUpgrades(_upgradeSettings with { OldFiles = value })" />
                    @if (value == OldFiles.Hold)
                    {
                        <span>
                            <strong>Hold the old file for
                                <NumberField Value="_upgradeSettings.HoldDays" Min="1" Max="365" Label="Days to hold"
                                             ValueChanged="n => SetUpgrades(_upgradeSettings with { HoldDays = n })" />
                                days, then approve the upgrade</strong>
                            <span class="muted small">@label</span>
                        </span>
                    }
                    else
                    {
                        <span><strong>Delete the old file straight away</strong><span class="muted small">@label</span></span>
                    }
                </label>
            }
            <div class="toolbar">
                <button class="primary" @onclick="SaveUpgradesAsync">Save</button>
                @if (_upgradesSaved) { <span class="muted small">Saved.</span> }
                @if (_upgradeError is not null) { <span class="error small" title="@_upgradeError">@_upgradeError</span> }
            </div>
            <div class="setting-line">
                <span>
                    @(upgrades.Upgradable == 1 ? "1 song is below its cutoff." : $"{upgrades.Upgradable} songs are below their cutoff.")
                </span>
                <span class="spacer"></span>
                <button @onclick="SearchUpgradesAsync" disabled="@(_searching || upgrades.Upgradable == 0)">Look for upgrades now</button>
            </div>
            <div class="muted small">
                As many as a scheduled look asks for (500 at most), starting now, whatever the time. A song, album or artist can be looked for on its own page.
                @if (_searched is { } found)
                {
                    <span>@(found.Queued == 0 ? "Nothing new to look for: the rest are being looked for already." : $"Looking for {found.Queued}: they're in Activity.")</span>
                }
            </div>
        </div>

        @if (upgrades.Held.Count > 0)
        {
            <p class="muted small">
                @(upgrades.Held.Count == 1 ? "1 upgrade is" : $"{upgrades.Held.Count} upgrades are") waiting to be approved or rolled back under
                <a href="review/upgraded">Review → Upgraded</a>.
            </p>
        }
    }

}

@code {
    private QualityProfile? _profile;
    private List<(QualityStep Step, bool Allowed)>? _steps;
    private bool _saved;
    private bool _stepsOpen;
    private string? _saveError;

    private SpectrumStatus? _spectra;

    private UpgradeStatus? _upgrades;
    private UpgradeSettings? _upgradeSettings;
    private UpgradeSearch? _searched;
    private bool _upgradesSaved, _searching;
    private string? _upgradeError;

    private static readonly (OldFiles Value, string Help)[] OldFileOptions =
    [
        (OldFiles.Hold, "Until then the upgrade can be rolled back, under Review → Upgraded or on the song's page; approving it deletes the old file sooner."),
        (OldFiles.Delete, "Nothing can be rolled back."),
    ];
    private bool _checking, _checkQueued;

    private static readonly (SuspectLossless Value, string Label, string Help)[] SuspectOptions =
    [
        (SuspectLossless.Refuse, "Refuse it", "The next candidate is tried. It's left in staging, so if nothing better is found it can be kept anyway under Review → Couldn't fetch."),
        (SuspectLossless.Keep, "Keep it as what it seems", "It's filed if the profile allows the quality it seems to be, and counts as that, below the cutoff, for upgrades."),
    ];

    protected override async Task OnInitializedAsync()
    {
        _profile = await Api.GetQualityProfileAsync();
        _steps = _profile.Ordered().ToList();
        try
        {
            _spectra = await Api.GetSpectrumStatusAsync();
        }
        catch (HttpRequestException)
        {
            // Shown without it.
        }
        await LoadUpgradesAsync();
    }

    private async Task LoadUpgradesAsync()
    {
        try
        {
            _upgrades = await Api.GetUpgradesAsync();
            _upgradeSettings ??= _upgrades.Settings;
        }
        catch (HttpRequestException)
        {
            // Shown without it.
        }
    }

    // Monday first.
    private static readonly DayOfWeek[] Week = [.. Enumerable.Range(1, 7).Select(i => (DayOfWeek)(i % 7))];

    // The browser's own time zone, which the schedule is saved in.
    private static string BrowserZone => TimeZoneInfo.Local.Id;

    private void ToggleDay(DayOfWeek day) =>
        SetUpgrades(_upgradeSettings! with { Days = _upgradeSettings.Days.Contains(day) ? _upgradeSettings.Days.Where(d => d != day).ToList() : [.. _upgradeSettings.Days, day] });

    private void SetTime(object? value, Func<TimeOnly, UpgradeSettings> with)
    {
        if (TimeOnly.TryParse(value?.ToString(), out var time))
            SetUpgrades(with(time));
    }

    private void SetUpgrades(UpgradeSettings value)
    {
        _upgradeSettings = value;
        _upgradesSaved = false;
    }

    private async Task SaveUpgradesAsync()
    {
        _upgradeError = null;
        try
        {
            await Api.SaveUpgradeSettingsAsync(_upgradeSettings! with { TimeZone = BrowserZone });
            _upgradesSaved = true;
            _upgradeSettings = null;
            await LoadUpgradesAsync();
        }
        catch (MelodexApiException e)
        {
            _upgradeError = e.Message;
        }
    }

    private async Task SearchUpgradesAsync()
    {
        _searching = true;
        try
        {
            _searched = await Api.SearchUpgradesAsync(new FormatScope(FormatScopeKind.Library));
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _upgradeError = e.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task CheckAsync(bool again)
    {
        _checking = true;
        try
        {
            await Api.CheckSpectraAsync(again);
            _checkQueued = true;
            _spectra = await Api.GetSpectrumStatusAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _saveError = e.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private string Cutoff
    {
        get => _profile!.Cutoff;
        set { _profile = _profile! with { Cutoff = value }; _saved = false; }
    }

    private string ListenTarget
    {
        get => _profile!.ListenTarget;
        set { _profile = _profile! with { ListenTarget = value }; _saved = false; }
    }

    private int CutoffIndex => _steps!.FindIndex(s => s.Step.Key == _profile!.Cutoff);

    private static string LevelHeading(QualityLevel level) => level switch
    {
        QualityLevel.HiRes => "Hi-res lossless: more than 16 bits or 48 kHz",
        QualityLevel.Lossless => "Lossless at CD quality",
        QualityLevel.High => "Lossy, high: about MP3 at 320 kbps",
        QualityLevel.Good => "Lossy, good: about MP3 V0",
        QualityLevel.Fair => "Lossy, fair: about MP3 at 160 to 220 kbps",
        _ => "Lossy, low: under about MP3 at 160 kbps",
    };

    private void SetAllowed(int index, bool allowed)
    {
        _steps![index] = (_steps[index].Step, allowed);
        // The cutoff has to be one that's wanted: turned off, it moves to the next one up that is.
        if (!allowed && _steps[index].Step.Key == _profile!.Cutoff
            && _steps.Take(index).LastOrDefault(s => s.Allowed) is { Step: var up } && up != default)
            _profile = _profile with { Cutoff = up.Key };
        _saved = false;
    }

    private void Move(int index, int by)
    {
        (_steps![index], _steps[index + by]) = (_steps[index + by], _steps[index]);
        _saved = false;
    }

    private void Reset()
    {
        _profile = new QualityProfile();
        _steps = _profile.Ordered().ToList();
        _saved = false;
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _saveError = null;
        try
        {
            await Api.SaveQualityProfileAsync(_profile! with { Steps = _steps!.Select(s => new ProfileStep(s.Step.Key, s.Allowed)).ToList() });
            _saved = true;
        }
        catch (MelodexApiException e)
        {
            _saveError = e.Message;
        }
    }
}
