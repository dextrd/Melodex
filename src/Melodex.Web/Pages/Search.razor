@page "/search"
@using Microsoft.JSInterop
@inject MelodexClient Api
@inject AuthState Auth
@inject NavigationManager Navigation
@inject Player Player
@inject Preferences Prefs
@inject SearchMemory Memory
@inject Glimpses Glimpses
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Search · Melodex</PageTitle>

<h1>Search</h1>

@if (_file is not null)
{
    <div class="notice">
        Choosing the song for <strong>@(_file.Title ?? "(no title)")</strong> <span class="muted">· @(_file.Artist ?? "unknown artist") · @Format.Duration(_file.DurationSeconds)</span>
        <div class="muted small">@_file.Path</div>
        <div class="row" style="margin-top: .4rem;"><a class="small" href="review">Back to Review</a></div>
    </div>
}
else if (_song is not null)
{
    <div class="notice">
        Choosing the song for <strong>@_song.Title</strong>
        <span class="muted">· @(_song.Artist ?? "unknown artist")@(_song.Album is { } album ? $" · {album}" : "")@(_song.DurationSeconds is { } length ? $" · {Format.Duration(length)}" : "")</span>
        <div class="row" style="margin-top: .4rem;"><a class="small" href="@_songBack">@(UnmatchedId is null ? "Back to the import" : "Back to Review")</a></div>
    </div>
}

<div class="library-bar search-bar">
    <div class="toolbar one-line">
        <input class="filter search-box" type="search" placeholder="@SearchHint" aria-label="Search" @bind="_query" @bind:event="oninput" @bind:after="TypedAsync"
               @onkeydown="KeyAsync" />
        <button class="icon-button filter-toggle @(_searchOpen ? "on" : "")" type="button" title="Search" aria-label="Search"
                aria-expanded="@(_searchOpen ? "true" : "false")" @onclick="ToggleSearch">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>
        </button>
        <Segmented T="string" Value="_kind" Options="Kinds" OnChange="KindAsync" Label="Show" />
        @* Coloured like the library's owned, all and missing, in the same order. *@
        <Segmented T="string" Value="_owned" Options="OwnedOptions" OnChange="v => _owned = v" Label="In your library" Class="@($"ownership {(_owned == "" ? "all" : _owned)}")" />
        <SortMenu Options="SortOptions" Value="@_sort" Descending="_descending" CanReverse="@(_sort != "relevance")" DirectionHint="@DirectionHint"
                  OnChange="key => _sort = key" OnReverse="() => _descending = !_descending" />
        <span class="spinner ownership-busy @(_remoteBusy || _localBusy ? "on" : "")" role="status" aria-label="@(_remoteBusy || _localBusy ? "Searching" : null)"></span>
    </div>
    @* Where there's no room for the box in the row, it shows below it, open to start with: searching is what the page is for. *@
    @if (_searchOpen)
    {
        <div class="filter-drop">
            <input type="search" placeholder="@SearchHint" aria-label="Search" @ref="_searchDrop" @bind="_query" @bind:event="oninput" @bind:after="TypedAsync"
                   @onkeydown="KeyAsync" />
        </div>
    }
</div>

@if (_results is null)
{
    @if (_searchError is not null)
    {
        <div class="notice error">@_searchError</div>
    }
    else if (_recentArtists.Count > 0 || _recent.Count > 0)
    {
        @if (_recentArtists.Count > 0)
        {
            <div class="section-head">
                <h2>Recent artists</h2>
                <button class="link small muted" @onclick="ClearRecentArtistsAsync">Clear</button>
            </div>
            <div class="tiles recent-artists">
                @foreach (var artist in _recentArtists)
                {
                    <div class="tile-wrap" @key="artist.Id">
                        <a class="tile" href="@(artist.Local ? "local/artists" : "artists")/@artist.Id" title="@(artist.Disambiguation is null ? artist.Name : $"{artist.Name} ({artist.Disambiguation})")"
                           @onclick="() => RememberArtistAsync(artist)">
                            <Cover Url="@artist.ImageUrl" Artist="true" />
                            <div class="tile-name">@artist.Name</div>
                            @if (artist.Disambiguation is not null) { <div class="muted small tile-sub">@artist.Disambiguation</div> }
                        </a>
                        <IconButton Icon="cancel" Class="remove tile-corner" Title="@($"Forget {artist.Name}")" OnClick="() => ForgetArtistAsync(artist)" />
                    </div>
                }
            </div>
        }
        @if (_recent.Count > 0)
        {
            <div class="section-head">
                <h2>Recent searches</h2>
                <button class="link small muted" @onclick="ClearRecentAsync">Clear</button>
            </div>
            <div class="recent-searches">
                @foreach (var recent in _recent)
                {
                    <span class="chip">
                        <a href="@SearchLink(recent)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2.5" /></svg>
                            <span class="ellipsis">@recent</span>
                        </a>
                        <button class="chip-remove" title="Forget this search" aria-label="Forget @recent" @onclick="() => ForgetAsync(recent)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>
                        </button>
                    </span>
                }
            </div>
        }
    }
    else
    {
        <div class="empty card">
            @if (Catalogue)
            {
                @:Search the catalogue for an artist, album or track. Results show what you have and what you're missing, and anything can be fetched
                @:or listened to from here. As you type, matches from what Melodex already holds show at once.
            }
            else
            {
                @:Search your library for an artist, album or track. With no catalogue set up, there's only your own music to search; add one, such as
                @:MusicBrainz, under Settings → Plugins to find music you don't have.
            }
        </div>
    }
}
else
{
    @* Using a result (opening it, playing it, fetching it) is what makes a search worth remembering. *@
    <div class="search-results" @onclick="UsedResultsAsync">
    @if (_remoteBusy)
    {
        <Loading Inline="true" Text="@(_localOnly ? "Showing what Melodex already knows; searching the catalogue…" : "Searching the catalogue…")" />
    }
    else if (_localOnly && Catalogue)
    {
        <div class="muted small search-note">From what Melodex already holds. Press Enter to search the catalogue.</div>
    }
    @if (_searchError is not null) { <div class="notice error">@_searchError</div> }
    @if (Artists.Count + Albums.Count + Tracks.Count == 0 && !_remoteBusy)
    {
        <div class="empty card">No results@(_owned != "" || _kind != "" ? " with these filters" : "").</div>
    }
    @if ((_file is not null || _song is not null) && Tracks.Count > 0)
    {
        <h2>Tracks</h2>
        @if (_error is not null) { <div class="notice error">@_error</div> }
        @TrackList(track => @<button class="primary small" disabled="@_matching" @onclick="() => (_song is null ? MatchAsync(track) : ChooseAsync(track))">This one</button>)
    }
@if (Artists.Count > 0)
    {
        <h2>Artists</h2>
        <div class="tiles">
            @foreach (var artist in Artists)
            {
                <div class="tile-wrap arrives">
                    <a class="tile" href="@(artist.Local ? "local/artists" : "artists")/@artist.Id" title="@(artist.Disambiguation is null ? artist.Name : $"{artist.Name} ({artist.Disambiguation})")"
                       @onclick="() => RememberArtistAsync(new RecentArtist(artist.Id, artist.Name, artist.Disambiguation, artist.ImageUrl, artist.Local))">
                        <Cover Url="@artist.ImageUrl" Artist="true" />
                        <div class="tile-name">@artist.Name</div>
                        @if (artist.Disambiguation is not null) { <div class="muted small tile-sub">@artist.Disambiguation</div> }
                        @if (artist.InLibrary) { <div><span class="badge owned">In library</span></div> }
                    </a>
                    <ItemMenu What="artist" Class="tile-menu" Name="@artist.Name" ArtistHref="@($"{(artist.Local ? "local/artists" : "artists")}/{artist.Id}")"
                              RadioFrom="@(artist.Local ? null : artist.Id)"
                              Get="@(artist.Local ? null : (RequestKind.Artist, artist.Id))" GetLabel="Get everything missing"
                              Upgrade="@(artist.InLibrary && !artist.Local ? new FormatScope(FormatScopeKind.Artist, artist.Id) : null)" />
                </div>
            }
        </div>
    }
    @if (Albums.Count > 0)
    {
        <h2>Albums</h2>
        <div class="card">
            <table class="table track-list narrow-status">
                <colgroup><col class="cover-col" /><col /><col class="status-col" /><col class="wide-action-col" /></colgroup>
                <tbody>
                    @foreach (var album in Albums)
                    {
                        <tr class="arrives">
                            <td class="cover-col"><a href="@Format.AlbumHref(album)" tabindex="-1"><Cover Url="@album.CoverUrl" /></a></td>
                            <td class="track-main">
                                <div class="ellipsis"><a href="@Format.AlbumHref(album)">@album.Title</a></div>
                                <div class="muted small ellipsis">
                                    <span class="show-narrow"><StatusBadge Album="album.Status" PartlyCovered="album.PartlyCovered" /></span>
                                    @if (album.Local) { @album.ArtistCredit } else { <a href="artists/@album.ArtistId" @onclick="() => RememberArtistAsync(album.ArtistId, album.ArtistCredit)">@album.ArtistCredit</a> }@(Format.Year(album.FirstReleaseDate) is { Length: > 0 } year ? $" · {year}" : "") · @Format.TypeLabel(album.Type)
                                </div>
                            </td>
                            <td class="num hide-narrow"><StatusBadge Album="album.Status" PartlyCovered="album.PartlyCovered" /></td>
                            <td class="num actions">
                                @{
                                    var missing = album.Status == AlbumStatus.Missing;
                                    RenderFragment play = @<text>
                                        @if (missing)
                                        {
                                            <WishButton Kind="RequestKind.Album" Id="album.Id">
                                                <IconButton Icon="listen" Requires="@UserPermissions.Listen" Title="Listen: fetch it to play now, without adding it to your library" OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                            </WishButton>
                                        }
                                        else
                                        {
                                            <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="@(album.Status == AlbumStatus.Partial ? "Play, fetching the tracks you don't have to listen to" : "Play")"
                                                        OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                        }
                                        <ItemMenu What="album" AlbumId="album.Id" AlbumStatus="album.Status" Name="@album.Title" Wish="@(missing || album.Status == AlbumStatus.Partial ? (RequestKind.Album, album.Id) : null)"
                                                  Upgrade="@(!album.Local && album.Status is AlbumStatus.Complete or AlbumStatus.Partial ? new FormatScope(FormatScopeKind.Album, album.Id) : null)"
                                                  ArtistHref="@(album.Local ? null : $"artists/{album.ArtistId}")"
                                                  Get="@(!album.Local && album.Status is AlbumStatus.Missing or AlbumStatus.Partial ? (RequestKind.Album, album.Id) : null)"
                                                  GetLabel="@(missing ? "Get it into your library" : "Get the tracks you're missing")" />
                                    </text>;
                                }
                                @if (album.Local)
                                {
                                    <ItemMenu What="album" AlbumId="album.Id" AlbumStatus="album.Status" Name="@album.Title" NoRadio="true" />
                                }
                                else if (album.Status is AlbumStatus.Missing or AlbumStatus.Partial)
                                {
                                    <FetchButton Kind="RequestKind.Album" Id="album.Id" Button="false">@play</FetchButton>
                                }
                                else
                                {
                                    @play
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (_file is null && _song is null && Tracks.Count > 0)
    {
        <h2>Tracks</h2>
        @TrackList(track => @<text>
            @if (track.Owned)
            {
                <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="Play" OnClick="() => Player.PlayAsync([PlayerEntry.Owned(track)])" />@* no space: buttons line up from row to row *@<ItemMenu Entry="PlayerEntry.Owned(track)" Keep="[new PlaylistItem(track.Id)]" Name="@track.Title" UpgradeTrackId="track.Id"
                          AlbumHref="@(track.AlbumId is { } albumId ? $"albums/{albumId}" : null)" ArtistHref="@(track.ArtistId is { } artistId ? $"artists/{artistId}" : null)" />
            }
            else
            {
                <FetchButton Kind="RequestKind.Track" Id="track.Id" Button="false">
                    <WishButton Kind="RequestKind.Track" Id="track.Id">
                        <IconButton Icon="listen" Requires="@UserPermissions.Listen" Title="Listen: fetch it to play now, without adding it to your library" OnClick="() => Player.ListenAsync(track.Id)" />
                    </WishButton>@* no space: it lines up with an owned song's play button *@<ItemMenu ListenTrackId="track.Id" Name="@track.Title" Get="(RequestKind.Track, track.Id)" Wish="(RequestKind.Track, track.Id)"
                              AlbumHref="@(track.AlbumId is { } albumId ? $"albums/{albumId}" : null)" ArtistHref="@(track.ArtistId is { } artistId ? $"artists/{artistId}" : null)" />
                </FetchButton>
            }
        </text>)
    }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    /// <summary>A file from the Review page to choose the song for.</summary>
    [SupplyParameterFromQuery(Name = "file")] public Guid? FileId { get; set; }

    /// <summary>An import's song to choose the song for, before the import is applied: the import and the line.</summary>
    [SupplyParameterFromQuery(Name = "import")] public Guid? ImportId { get; set; }

    [SupplyParameterFromQuery(Name = "line")] public Guid? LineId { get; set; }

    /// <summary>An imported song nothing was found for, from Review, to choose the song for.</summary>
    [SupplyParameterFromQuery(Name = "unmatched")] public Guid? UnmatchedId { get; set; }

    private static readonly IReadOnlyList<(string Value, string Label, string? Hint)> Kinds =
        [("", "All", null), ("artists", "Artists", "Only artists, which is quicker"), ("albums", "Albums", "Only albums, which is quicker"), ("tracks", "Tracks", "Only tracks, which is quicker")];

    private static readonly IReadOnlyList<(string Value, string Label, string? Hint)> OwnedOptions =
        [("owned", "Owned", "Only what you have"), ("", "All", "Whether you have it or not"), ("missing", "Missing", "Only what you don't have")];

    private const string SearchHint = "Artist, album or track";

    /// <summary>An artist opened from the search results, kept to open again.</summary>
    public sealed record RecentArtist(Guid Id, string Name, string? Disambiguation, string? ImageUrl, bool Local = false);

    private bool Catalogue => Auth.Status?.Catalogue != false;

    private static readonly IReadOnlyList<(string Key, string Label)> SortOptions = [("relevance", "Best match"), ("name", "Name"), ("year", "Year")];

    private string DirectionHint => _sort switch
    {
        "relevance" => "Best matches first",
        "year" => $"{(_descending ? "Newest" : "Oldest")} first; click to reverse",
        _ => $"Sorted {(_descending ? "Z to A" : "A to Z")}; click to reverse",
    };

    private const string RecentKey = "recentSearches";
    public const string RecentArtistsKey = "recentArtists";
    private const int RecentCount = 12;

    /// <summary>How long typing pauses before MusicBrainz is asked, too: long enough not to ask about half a word.</summary>
    private static readonly TimeSpan RemotePause = TimeSpan.FromMilliseconds(700);

    private List<RecentArtist> _recentArtists = [];
    private bool _searchOpen = true;
    private bool _focusSearch;
    private ElementReference _searchDrop;

    // The search the page has run itself, as you typed: its address changing needn't run it again.
    private string? _shown;

    private string _query = "";
    private string _kind = "";
    private string _owned = "";
    private string _sort = "relevance";
    private bool _descending;
    private SearchResults? _results;
    private bool _localOnly;
    private bool _remoteBusy;
    private bool _localBusy;
    private List<string> _recent = [];
    private ReviewItem? _file;
    private ImportSong? _song;
    private string _songBack = "tools";
    private string? _error;
    private string? _searchError;
    private bool _matching;
    private CancellationTokenSource? _typing;
    private int _searches;

    private IReadOnlyList<string>? KindList => _kind.Length == 0 ? null : [_kind];

    private bool Shows(bool owned) => _owned switch { "owned" => owned, "missing" => !owned, _ => true };

    private IEnumerable<T> Sort<T>(IEnumerable<T> items, Func<T, string> name, Func<T, string?> year)
    {
        var text = StringComparer.CurrentCultureIgnoreCase;
        return _sort switch
        {
            "name" => _descending ? items.OrderByDescending(name, text) : items.OrderBy(name, text),
            "year" => _descending ? items.OrderByDescending(i => year(i) ?? "") : items.OrderBy(i => year(i) ?? "9999"),
            _ => items,
        };
    }

    private List<SearchArtist> Artists => _results is null ? [] : Sort(_results.Artists.Where(a => Shows(a.InLibrary)), a => a.Name, _ => null).ToList();

    private List<AlbumSummary> Albums => _results is null ? [] :
        Sort(_results.Albums.Where(a => Shows(a.Status is AlbumStatus.Complete or AlbumStatus.Partial)), a => a.Title, a => a.FirstReleaseDate).ToList();

    private List<SearchTrack> Tracks => _results is null ? [] : Sort(_results.Tracks.Where(t => Shows(t.Owned)), t => t.Title, _ => null).ToList();

    private IDisposable? _leaving;
    private double _scrollY;
    private double? _restoreScroll;
    private bool _restored;

    protected override async Task OnInitializedAsync()
    {
        _recent = await Prefs.GetAsync<List<string>>(RecentKey, []);
        _recentArtists = await Prefs.GetAsync<List<RecentArtist>>(RecentArtistsKey, []);
        // Where it was scrolled to is read on the way out, while the page is still there to read.
        _leaving = Navigation.RegisterLocationChangingHandler(async _ =>
        {
            try
            {
                _scrollY = await JS.InvokeAsync<double>("melodexScroll.get");
            }
            catch (JSException)
            {
            }
        });
        if (Recall() is { } kept)
        {
            // Back to the last search, as it was left: the address is put back to say so.
            _query = kept.Query;
            _kind = kept.Kind;
            _owned = kept.Owned;
            _sort = kept.Sort;
            _descending = kept.Descending;
            _results = kept.Results;
            _shown = kept.Query;
            _restoreScroll = kept.ScrollY;
            _restored = true;
            if (kept.FileId is { } fileId && Auth.May(UserPermissions.Review))
                _file = await FindFileAsync(fileId);
            await FindSongAsync();
            if ((Query ?? "").Trim() != kept.Query)
                Navigation.NavigateTo(SearchLink(kept.Query), replace: true);
            if (kept.Busy)
                _ = InvokeAsync(async () =>
                {
                    await SearchAsync(kept.Query, remember: false);
                    StateHasChanged();
                });
        }
    }

    // The search left last, when coming back to the bare Search page or to that same search, for the same file.
    private SearchMemory.Kept? Recall() => Memory.Recall() is { } kept && ((Query ?? "").Trim() is var asked && (asked.Length == 0 || asked == kept.Query))
                                           && kept.FileId == FileId
        ? kept
        : null;

    protected override async Task OnParametersSetAsync()
    {
        // Just put back as it was left, so there's nothing to search for.
        if (_restored)
        {
            _restored = false;
            return;
        }
        // The address followed what's being typed; what's typed may have moved on since, so leave it be.
        if (_shown is not null && (Query ?? "").Trim() == _shown)
            return;
        _shown = null;
        _query = Query ?? "";
        _file = FileId is { } fileId && Auth.May(UserPermissions.Review) ? await FindFileAsync(fileId) : null;
        await FindSongAsync();
        _searchError = null;
        // What's shown (matches found while typing, say) stays until the search has something to replace it with.
        if (_query.Trim().Length > 0)
            await SearchAsync(_query.Trim());
        else
            _results = null;
    }

    // The file being matched may be under review, or one of those set aside, such as an excluded file matched from its album page.
    private async Task<ReviewItem?> FindFileAsync(Guid fileId)
    {
        foreach (var list in Enum.GetValues<ReviewList>())
            if ((await Api.GetReviewAsync(list)).FirstOrDefault(i => i.FileId == fileId) is { } item)
                return item;
        return null;
    }

    // Matches from what Melodex already holds show at once. MusicBrainz is asked for artists, albums and tracks
    // separately, and each answer is added as it comes, so quick ones (artists, usually) needn't wait for the slowest:
    // what's shown keeps its place, with MusicBrainz's newer details, and the rest follows.
    private async Task SearchAsync(string text, bool remember = true)
    {
        var search = ++_searches;
        _remoteBusy = true;
        _searchError = null;
        if (remember)
            await RememberAsync(text);
        // Without a catalogue, what Melodex holds is all there is.
        var pending = Catalogue ? (KindList ?? AllKinds).Select(kind => Api.SearchAsync(text, [kind])).ToList() : [];
        // What's shown may still be the last search's, kept so the page doesn't flash: the first answer replaces it.
        var ours = false;
        try
        {
            var local = await Api.SearchAsync(text, KindList, local: true);
            if (search == _searches)
            {
                _results = local;
                _localOnly = ours = true;
                StateHasChanged();
            }
        }
        catch (HttpRequestException)
        {
        }

        while (pending.Count > 0)
        {
            var done = await Task.WhenAny(pending);
            pending.Remove(done);
            if (search != _searches)
                return;
            try
            {
                var found = await done;
                _results = ours && _results is { } shown ? Merge(shown, found) : found;
                ours = true;
                _localOnly = false;
            }
            catch (HttpRequestException e)
            {
                _searchError = e.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                    ? "The catalogue is busy right now, so some results may be missing. Try again in a moment."
                    : "Searching the catalogue failed, so some results may be missing. Try again in a moment.";
            }
            if (pending.Count > 0)
                StateHasChanged();
        }
        _localOnly = false;
        _remoteBusy = false;
    }

    private static readonly IReadOnlyList<string> AllKinds = ["artists", "albums", "tracks"];

    // A song is the same one on the same album with the same title and artist, though it may be another copy of it.
    private static SearchResults Merge(SearchResults shown, SearchResults found) => new(
        Merge(shown.Artists, found.Artists, a => a.Id), Merge(shown.Albums, found.Albums, a => a.Id),
        Merge(shown.Tracks, found.Tracks, t => (t.Title.Trim().ToLowerInvariant(), t.ArtistCredit.Trim().ToLowerInvariant(), t.AlbumId)));

    private static List<T> Merge<T, TKey>(IReadOnlyList<T> shown, IReadOnlyList<T> found, Func<T, TKey> key) where TKey : notnull
    {
        var newer = found.DistinctBy(key).ToDictionary(key);
        return [.. shown.Select(s => newer.GetValueOrDefault(key(s), s)), .. found.Where(f => shown.All(s => !Equals(key(s), key(f))))];
    }

    // As you type, what Melodex already holds; when typing pauses a little longer, MusicBrainz too, and the address
    // follows. Enter asks MusicBrainz at once.
    private async Task TypedAsync()
    {
        _typing?.Cancel();
        var text = _query.Trim();
        if (text.Length == 0)
        {
            // Cleared: back to the recent artists and searches.
            ++_searches;
            _results = null;
            _searchError = null;
            _remoteBusy = _localBusy = false;
            _shown = "";
            Navigation.NavigateTo(SearchLink(""), replace: true);
            return;
        }
        if (text.Length < 2)
            return;
        var typing = _typing = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, typing.Token);
            _localBusy = true;
            StateHasChanged();
            var search = ++_searches;
            var local = await Api.SearchAsync(text, KindList, local: true, typing.Token);
            if (search != _searches)
                return;
            _results = local;
            _localOnly = true;
            _remoteBusy = false;
            _searchError = null;
            _localBusy = false;
            StateHasChanged();

            await Task.Delay(RemotePause, typing.Token);
            _shown = text;
            Navigation.NavigateTo(SearchLink(text), replace: true);
            await SearchAsync(text, remember: false);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            if (_typing == typing)
                _localBusy = false;
        }
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAsync();
    }

    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        _focusSearch = _searchOpen;
    }

    // The results shown last, kept for the pages they lead to.
    private SearchResults? _glimpsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_results is { } results && !ReferenceEquals(results, _glimpsed))
            Glimpses.Saw(_glimpsed = results);
        if (_restoreScroll is { } y)
        {
            _restoreScroll = null;
            try
            {
                await JS.InvokeVoidAsync("melodexScroll.to", y);
            }
            catch (JSException)
            {
            }
        }
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchDrop.FocusAsync();
        }
    }

    // Opening, playing or fetching something from the results.
    private async Task UsedResultsAsync()
    {
        var text = _query.Trim();
        if (text.Length > 0 && _recent.FirstOrDefault() != text)
            await RememberAsync(text);
    }

    /// <summary>
    /// An artist opened from an album or track: named as far as known for now, as a credit can name several. Their page
    /// puts their own name and picture in once it loads.
    /// </summary>
    private Task RememberArtistAsync(Guid id, string credit) =>
        RememberArtistAsync(new RecentArtist(id, Glimpses.Artist(id)?.Name ?? credit, null, $"api/v1/artwork/artist/{id}"));

    private async Task RememberArtistAsync(RecentArtist artist)
    {
        _recentArtists = [artist, .. _recentArtists.Where(a => a.Id != artist.Id)];
        if (_recentArtists.Count > RecentCount)
            _recentArtists = _recentArtists[..RecentCount];
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    /// <summary>
    /// An artist's page, opened: put first among the recent artists when it was reached from a search, however many
    /// pages on (a song's, then its artist's); otherwise only brought up to date if it's there, as one opened from a
    /// song's credit was kept under the credit, which can name several.
    /// </summary>
    public static async Task OpenedArtistAsync(Preferences prefs, RecentArtist artist, bool fromSearch)
    {
        var recent = await prefs.GetAsync<List<RecentArtist>>(RecentArtistsKey, []);
        var index = recent.FindIndex(a => a.Id == artist.Id);
        if (fromSearch)
        {
            var updated = index < 0 ? artist : artist with { ImageUrl = artist.ImageUrl ?? recent[index].ImageUrl };
            List<RecentArtist> next = [updated, .. recent.Where(a => a.Id != artist.Id)];
            if (next.Count > RecentCount)
                next = next[..RecentCount];
            if (!next.SequenceEqual(recent))
                await prefs.SetAsync(RecentArtistsKey, next);
            return;
        }
        if (index < 0)
            return;
        var named = recent[index] with { Name = artist.Name, Disambiguation = artist.Disambiguation, ImageUrl = artist.ImageUrl ?? recent[index].ImageUrl };
        if (named == recent[index])
            return;
        recent[index] = named;
        await prefs.SetAsync(RecentArtistsKey, recent);
    }

    private async Task ForgetArtistAsync(RecentArtist artist)
    {
        _recentArtists = _recentArtists.Where(a => a.Id != artist.Id).ToList();
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    private async Task ClearRecentArtistsAsync()
    {
        _recentArtists = [];
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    private async Task KindAsync(string kind)
    {
        _kind = kind;
        if (_results is not null && _query.Trim().Length > 0)
            await SearchAsync(_query.Trim());
    }

    private async Task RememberAsync(string text)
    {
        _recent = [text, .. _recent.Where(r => !string.Equals(r, text, StringComparison.OrdinalIgnoreCase))];
        if (_recent.Count > RecentCount)
            _recent = _recent[..RecentCount];
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private async Task ForgetAsync(string text)
    {
        _recent = _recent.Where(r => r != text).ToList();
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private async Task ClearRecentAsync()
    {
        _recent = [];
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private string SearchLink(string text) => $"search?q={Uri.EscapeDataString(text)}{(_file is null ? "" : $"&file={_file.FileId}")}{Choosing}";

    // The imported song being chosen for, kept in the address as the search changes.
    private string Choosing => UnmatchedId is { } unmatched ? $"&unmatched={unmatched}"
        : ImportId is { } import && LineId is { } line ? $"&import={import}&line={line}"
        : "";

    private Task SubmitAsync()
    {
        _typing?.Cancel();
        var text = _query.Trim();
        if (text.Length == 0)
            return Task.CompletedTask;
        // The same search again (a press of Enter after typing) doesn't change the address, so run it here.
        if (text == (Query ?? "").Trim())
            return _shown == text && !_remoteBusy && _searchError is null ? RememberAsync(text) : SearchAsync(text);
        Navigation.NavigateTo(SearchLink(text));
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _typing?.Cancel();
        _leaving?.Dispose();
        if (_results is not null && _query.Trim().Length > 0)
            Memory.Keep(new SearchMemory.Kept(_query.Trim(), _file?.FileId, _kind, _owned, _sort, _descending, _results, _remoteBusy, _scrollY));
        else
            Memory.Forget();
    }

    /// <summary>
    /// Tracks as the library lists them, with their album's cover and what can be done with each; and whether you have
    /// them, unless a file's song is being chosen.
    /// </summary>
    private RenderFragment TrackList(RenderFragment<SearchTrack> actions) => __builder =>
    {
        <div class="card">
            <table class="table track-list narrow-status">
                <colgroup>
                    <col class="cover-col" /><col /><col class="length-col hide-narrow" />
                    @if (_file is null) { <col class="status-col" /> }
                    <col class="wide-action-col" />
                </colgroup>
                <tbody>
                    @foreach (var track in Tracks)
                    {
                        <tr class="arrives">
                            <td class="cover-col">
                                @if (track.AlbumId is { } albumId) { <a href="albums/@albumId" tabindex="-1"><Cover Url="@track.CoverUrl" /></a> }
                                else { <Cover Url="@track.CoverUrl" /> }
                            </td>
                            <td class="track-main">
                                <div class="ellipsis"><a href="tracks/@track.Id" class="plain">@track.Title</a>@if (!track.Owned) { <FetchNote Id="track.Id" /> }</div>
                                <div class="muted small ellipsis">
                                    @if (_file is null) { <span class="show-narrow"><StatusBadge Track="track.Owned ? TrackStatus.Owned : TrackStatus.Missing" /></span> }
                                    @if (track.ArtistId is { } artistId) { <a href="artists/@artistId" @onclick="() => RememberArtistAsync(artistId, track.ArtistCredit)">@track.ArtistCredit</a> } else { @track.ArtistCredit }
                                    @if (track.AlbumId is { } id) { <span> · <a href="albums/@id">@track.AlbumTitle</a></span> }
                                </div>
                            </td>
                            <td class="num muted hide-narrow">@Format.Duration(track.DurationSeconds)</td>
                            @if (_file is null)
                            {
                                <td class="num hide-narrow"><StatusBadge Track="track.Owned ? TrackStatus.Owned : TrackStatus.Missing" /></td>
                            }
                            <td class="num actions">@actions(track)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    // The imported song being chosen for, if any, and where to go back to.
    private async Task FindSongAsync()
    {
        _song = null;
        if (!Auth.May(UserPermissions.Request))
            return;
        if (ImportId is { } importId && LineId is { } lineId && await Api.GetImportAsync(importId) is { } import)
        {
            _song = import.Lines.FirstOrDefault(l => l.Id == lineId)?.Song;
            _songBack = $"tools/import/{importId}";
        }
        else if (UnmatchedId is { } unmatched)
        {
            _song = (await Api.GetUnmatchedImportSongsAsync()).FirstOrDefault(u => u.LineId == unmatched)?.Song;
            _songBack = "review";
        }
    }

    private async Task ChooseAsync(SearchTrack track)
    {
        _matching = true;
        _error = null;
        try
        {
            if (UnmatchedId is { } unmatched)
                await Api.MatchUnmatchedImportSongAsync(unmatched, new MatchImportSong(track.Id));
            else
                await Api.ChangeImportLineAsync(ImportId!.Value, LineId!.Value, new ChangeImportLine(TrackId: track.Id));
            Navigation.NavigateTo(_songBack);
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        _matching = false;
    }

    private async Task MatchAsync(SearchTrack track)
    {
        _matching = true;
        _error = null;
        try
        {
            await Api.MatchFileAsync(_file!.FileId, new MatchFile(track.Id));
            Navigation.NavigateTo("review");
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        _matching = false;
    }
}
