@page "/tracks/{Id:guid}"
@implements IDisposable
@inject PageCache Pages
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject Player Player
@inject Glimpses Glimpses
@inject Preferences Prefs

<PageTitle>@(_track?.Title ?? _glimpse?.Title ?? "Track") · Melodex</PageTitle>

@if (_notFound)
{
    <div class="empty card">That track isn't in the catalogue.</div>
}
else if (_track is null && _glimpse is { } glimpse)
{
    @* What the list it was opened from knew, at once; the albums it's on and its files follow. *@
    <div class="page-head">
        <Cover Url="@glimpse.CoverUrl" />
        <div>
            <h1>@glimpse.Title</h1>
            <div class="row muted small">
                @if (glimpse.ArtistId is { } artistId) { <a href="artists/@artistId">@glimpse.ArtistCredit</a> } else { <span>@glimpse.ArtistCredit</span> }
                @if (glimpse.DurationSeconds is not null) { <span>@Format.Duration(glimpse.DurationSeconds)</span> }
                <StatusBadge Track="@(glimpse.Owned ? TrackStatus.Owned : TrackStatus.Missing)" />
            </div>
            <fieldset class="row album-actions" disabled style="margin-top: .5rem;">
                @if (glimpse.Owned)
                {
                    <IconButton Icon="play" Requires="@UserPermissions.Listen" Primary="true" Large="true" Label="Play" Title="Play it" />
                    <IconButton Icon="queue" Requires="@UserPermissions.Listen" Large="true" Label="Add to queue" Title="Add to the queue" />
                    <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Large="true" Label="Add to playlist" Title="Add to a playlist" />
                }
                else
                {
                    <IconButton Icon="listen" Requires="@UserPermissions.Listen" Large="true" Label="Listen now" Title="Fetch it to play now, without adding it to your library" />
                    <IconButton Icon="get" Requires="@UserPermissions.Request" Large="true" Label="Get track" Title="Get it into your library" />
                }
            </fieldset>
        </div>
    </div>
    <h2 class="section"><span class="placeholder title"></span></h2>
    <div class="card" aria-busy="true">
        <table class="table">
            <tbody>
                @for (var i = 0; i < 3; i++)
                {
                    <tr>
                        <td><span class="placeholder" style="width: @(7 + i * 37 % 9)rem"></span></td>
                        <td class="hide-narrow"><span class="placeholder"></span></td>
                        <td class="num"><span class="placeholder short"></span></td>
                        <td><span class="placeholder badge-size"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_track is null)
{
    <Loading />
}
else
{
    var track = _track;
    var owned = track.Files.Count > 0;
    // Where it'd be fetched to or listened from: the edition you have it on, or the first it's on.
    var edition = track.Appearances.FirstOrDefault(a => a.InLibrary) ?? track.Appearances.FirstOrDefault();
    <div class="page-head">
        <Cover Url="@track.CoverUrl" />
        <div>
            <h1>@track.Title</h1>
            <div class="row muted small">
                <a href="artists/@track.ArtistId">@track.ArtistCredit</a>
                @if (track.DurationSeconds is not null) { <span>@Format.Duration(track.DurationSeconds)</span> }
                <StatusBadge Track="@(owned ? TrackStatus.Owned : track.Ignored ? TrackStatus.Ignored : TrackStatus.Missing)" />
                <ProviderIds Ids="track.Ids" Entity="recording" />
            </div>
            <div class="row album-actions" style="margin-top: .5rem;">
                @if (owned)
                {
                    <IconButton Icon="play" Requires="@UserPermissions.Listen" Primary="true" Large="true" Label="Play" Title="Play it" OnClick="() => Player.PlayAsync([Entry(track)])" />
                    <QueueButton Large="true" Left="true" Label="Add to queue" Title="Add to the queue: play next, or play last" OnQueue="next => Player.AddAsync([Entry(track)], next)" />
                    <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Large="true" Label="Add to playlist" Title="Add to a playlist" OnClick="() => _adding = (track.Title, [new PlaylistItem(track.Id)])" />
                    <StarButton Kind="MarkKind.Song" Id="track.Id" Large="true" />
                    <RatingStars Kind="MarkKind.Song" Id="track.Id" />
                }
                else if (!track.Ignored)
                {
                    <FetchButton Kind="RequestKind.Track" Id="track.Id" EditionId="edition?.EditionId" Large="true" Label="Get track" Hint="Get it into your library">
                        <WishButton Kind="RequestKind.Track" Id="track.Id" EditionId="edition?.EditionId" Large="true" Labelled="true">
                            <IconButton Icon="listen" Requires="@UserPermissions.Listen" Large="true" Label="Listen now" Title="Fetch it to play now, without adding it to your library"
                                        OnClick="() => Player.ListenAsync(track.Id, edition?.EditionId)" />
                        </WishButton>
                    </FetchButton>
                }
                <IconButton Icon="radio" Requires="@UserPermissions.Listen" Large="true" Label="Radio" Title="Start radio: play it, then songs like it, without end"
                            OnClick="() => Player.StartRadioAsync(track.Id)" />
            </div>
        </div>
    </div>

    <h2 class="section">
        <SectionToggle Open="IsOpen(Albums)" OnToggle="() => ToggleAsync(Albums)">On @Format.Count(track.Appearances.Select(a => a.AlbumId).Distinct().Count(), "album", "albums")</SectionToggle>
    </h2>
    <Collapsible Open="IsOpen(Albums)">
        @if (track.Appearances.Count == 0)
        {
            <div class="empty card">No albums in the catalogue list this song yet.</div>
        }
        else
        {
            <div class="card">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Album</th>
                            <th class="hide-narrow">Edition</th>
                            <th class="num">#</th>
                            <th class="hide-narrow">First released</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* One row an album: the edition you have it on, or the first, standing for the rest. *@
                        @foreach (var album in track.Appearances.GroupBy(a => a.AlbumId))
                        {
                            var on = album.FirstOrDefault(a => a.InLibrary) ?? album.First();
                            var others = album.Count() - 1;
                            <tr>
                                <td>
                                    <a href="albums/@on.AlbumId">@on.AlbumTitle</a>
                                    <span class="muted small"> · @Format.TypeLabel(on.AlbumType)</span>
                                    @if (on.Title != track.Title) { <div class="muted small">as “@on.Title”</div> }
                                </td>
                                <td class="hide-narrow muted small">
                                    @on.EditionTitle@(on.Country is null ? "" : $" ({on.Country})")
                                    @if (others > 0) { <span> and @Format.Count(others, "other", "others")</span> }
                                </td>
                                <td class="num muted nowrap">@(on.Disc > 1 ? $"{on.Disc}-" : "")@on.Number</td>
                                <td class="hide-narrow muted">@album.Select(a => a.ReleaseDate).Where(d => d is not null).Order().FirstOrDefault()</td>
                                <td><StatusBadge Album="on.AlbumStatus" PartlyCovered="on.PartlyCovered" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Collapsible>

    @if (owned)
    {
        <TrackLyricsPanel TrackId="track.Id" Title="@track.Title" OnChanged="LoadAsync" Open="IsOpen(Lyrics)" OnToggle="() => ToggleAsync(Lyrics)" />

        @*
            The files' quality and what's done to all of them are on the section's title row, as the lyrics' are, and so
            are one file's own buttons; with several, each file has its own.
        *@
        var single = track.Files.Count == 1;
        var qualities = track.Files.Select(f => f.Quality).OfType<FileQuality>().ToList();
        <div class="section-head">
            <h2><SectionToggle Open="IsOpen(Files)" OnToggle="() => ToggleAsync(Files)">@(single ? "File" : $"{track.Files.Count} files")</SectionToggle></h2>
            <QualityBadge Quality="FileQuality.Lowest(qualities)" Mixed="FileQuality.Mixed(qualities)" />
            <div class="row lyrics-actions @(IsOpen(Files) ? "" : "section-actions-shut")">
                <IconButton Icon="format" Requires="@UserPermissions.Format" Label="Format" Title="Rewrite this song's files: their tags, cover and where they live" OnClick="() => _formatting = true" />
                <IconButton Icon="image" Requires="@UserPermissions.Format" Label="Cover" Title="Choose this song's cover, from any release it's on or a picture of your own" OnClick="() => _choosingCover = true" />
                <QualityButton Kind="tracks" Id="track.Id" Name="@track.Title" />
                @if (single)
                {
                    @FileButtons((track, track.Files[0]))
                }
            </div>
        </div>
        <Collapsible Open="IsOpen(Files)">
            @foreach (var file in track.Files)
            {
                <div class="card track-file">
                    @if (single)
                    {
                        <code>@file.Path</code>
                    }
                    else
                    {
                        <div class="row track-file-head">
                            <code>@file.Path</code>
                            @FileButtons((track, file))
                        </div>
                    }
                    @if (_replaceError is { } error && _replacing is null)
                    {
                        <p class="error small">@error</p>
                    }
                    @* What the file is, then what its tags say, all as one list. *@
                    <dl class="file-tags">
                        @if (file.Quality is { Codec: not null } quality)
                        {
                            <dt>Format</dt>
                            <dd>@quality.Label (@quality.Details)</dd>
                        }
                        else if (file.Format is not null)
                        {
                            <dt>Format</dt>
                            <dd>@file.Format.ToUpperInvariant()</dd>
                        }
                        @if (file.DurationSeconds is not null)
                        {
                            <dt>Length</dt>
                            <dd>@Format.Duration(file.DurationSeconds)</dd>
                        }
                        <dt>Size</dt>
                        <dd>@Format.Size(file.Size)</dd>
                        @if (file.FormattedAt is { } formatted)
                        {
                            <dt>Last formatted</dt>
                            <dd title="@formatted.ToLocalTime().ToString("f")">@Format.Ago(formatted)</dd>
                        }
                        @foreach (var tag in file.Tags)
                        {
                            <dt>@tag.Name</dt>
                            <dd>@tag.Value</dd>
                        }
                    </dl>
                </div>
            }
        </Collapsible>
        @if (_held.Count > 0)
        {
            <h2 class="section"><SectionToggle Open="IsOpen(Upgrades)" OnToggle="() => ToggleAsync(Upgrades)">Replaced by an upgrade</SectionToggle></h2>
            <Collapsible Open="IsOpen(Upgrades)">
                <p class="muted small">
                    Held outside the music folder until it's deleted. Rolling back deletes the copy that replaced it and puts this one back; a later upgrade may replace it again, unless it's never to be upgraded.
                </p>
                <div class="card"><HeldFiles Files="_held" ShowTitle="false" Changed="LoadAsync" /></div>
            </Collapsible>
        }
    }

    <SimilarSongs TrackId="track.Id" Open="IsOpen(Similar)" OnToggle="() => ToggleAsync(Similar)" />
}

@if (_choosingCover && _track is not null)
{
    <CoverDialog Subject="CoverSubject.Track" Id="_track.Id" Name="@_track.Title" OnClose="() => _choosingCover = false"
                 OnChosen="url => _track = _track with { CoverUrl = url }" />
}

@if (_adding is { } adding)
{
    <AddToPlaylistDialog Name="@adding.Name" Songs="adding.Songs" Art="@_track?.CoverUrl" OnClose="() => _adding = null" />
}

@if (_replacing is { } replace && _track is not null)
{
    <Dialog Title="@($"Replace {_track.Title}?")" OnClose="() => _replacing = null">
        <p>
            Melodex fetches a new file for the song, passing over the one you have, and puts it in that file's place, tagged as it
            was. Use it for a song fetched as the wrong recording: the new one is found by the catalogue's length, and kept
            whatever its quality, as long as the profile allows it.
        </p>
        <p class="muted small">
            The song keeps its place in your library and in your playlists. The file you have now is held or deleted as upgrades'
            are, under Settings → Quality, so it can be put back.
        </p>
        <div class="toolbar dialog-buttons">
            <button @onclick="() => _replacing = null">Cancel</button>
            <button class="primary" disabled="@_busy" @onclick="() => ReplaceAsync(replace)">@if (_busy) { <span class="spinner"></span> }Replace it</button>
        </div>
    </Dialog>
}

@if (_removing is { } remove && _track is not null)
{
    <RemoveDialog Kind="LibraryItemKind.File" Id="remove.Id" Name="@_track.Title" OnClose="RemovedAsync" />
}

@if (_formatting && _track is not null)
{
    <FormatDialog Scope="new FormatScope(FormatScopeKind.Track, _track.Id)" Name="@_track.Title" OnClose="() => _formatting = false" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private TrackDetail? _track;
    private TrackGlimpse? _glimpse;
    private bool _notFound;
    private IReadOnlyList<HeldFileInfo> _held = [];
    private bool _formatting;
    private TrackFile? _replacing, _removing;
    private bool _busy;
    private string? _replaceError;

    // A new file being looked for in place of the song's.
    // Replacing a file and removing it.
    private RenderFragment FileButtons((TrackDetail Track, TrackFile File) at) => __builder =>
    {
        if (Replacing(at.Track) is { } replacing)
        {
            <a class="muted small" href="activity/downloads?open=@replacing.Id"><span class="spinner"></span> Looking for a new file</a>
        }
        else
        {
            <IconButton Icon="retry" Requires="@UserPermissions.Request" Label="Replace" Title="Fetch a new file for this song in its place, better or not, passing over this one: for the wrong recording. It keeps its place in playlists"
                        OnClick="() => _replacing = at.File" />
        }
        <IconButton Icon="remove" Requires="@UserPermissions.Remove" Label="Remove" Title="Take this file out of your library, deleting it or keeping it"
                    OnClick="() => _removing = at.File" />
    };

    private RequestInfo? Replacing(TrackDetail track) => Tracker.Requests.FirstOrDefault(r => r.Replace && r.TargetId == track.Id && r.Active);

    private async Task ReplaceAsync(TrackFile file)
    {
        _busy = true;
        _replaceError = null;
        try
        {
            // A notification says when it's replaced.
            Tracker.Watch(await Api.ReplaceFileAsync(file.Id));
            await Tracker.RefreshAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _replaceError = e.Message;
        }
        finally
        {
            _busy = false;
            _replacing = null;
        }
    }

    private async Task RemovedAsync(bool removed)
    {
        _removing = null;
        if (removed)
        {
            ScanStatus.RaiseLibraryChanged();
            await LoadAsync();
        }
    }
    private bool _choosingCover;
    private (string Name, IReadOnlyList<PlaylistItem> Songs)? _adding;

    // Which of the page's sections are open, kept between visits: the albums it's on, its lyrics and its files are open
    // until shut; what upgrades replaced and similar songs are shut until opened.
    private const string SectionsKey = "trackSections", Albums = "albums", Lyrics = "lyrics", Files = "files", Upgrades = "upgrades", Similar = "similar";
    private Dictionary<string, bool> _sections = [];
    private bool _sectionsLoaded;

    private bool IsOpen(string section) => _sections.TryGetValue(section, out var open) ? open : section is Albums or Lyrics or Files;

    private Task ToggleAsync(string section)
    {
        _sections[section] = !IsOpen(section);
        return Prefs.SetAsync(SectionsKey, _sections);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_sectionsLoaded)
        {
            _sections = await Prefs.GetAsync<Dictionary<string, bool>>(SectionsKey, []);
            _sectionsLoaded = true;
        }
        ScanStatus.LibraryChanged -= Reload;
        ScanStatus.LibraryChanged += Reload;
        Tracker.Changed -= Redraw;
        Tracker.Changed += Redraw;
        _ = Tracker.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_track?.Id != Id)
        {
            // Seen already this session: shown as it was while it's asked for again.
            _track = Pages.Get<TrackDetail>(Key);
            _glimpse = _track is null ? Glimpses.Track(Id) : null;
            _notFound = false;
        }
        _track = Pages.Keep(Key, await Api.GetTrackAsync(Id));
        _notFound = _track is null;
        try
        {
            _held = _track is { Files.Count: > 0 } ? await Api.GetHeldFilesAsync(Id) : [];
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _held = [];
        }
    }

    private string Key => $"track/{Id}";

    private void Reload() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ScanStatus.LibraryChanged -= Reload;
        Tracker.Changed -= Redraw;
    }

    private static PlayerEntry Entry(TrackDetail track)
    {
        var on = track.Files[0].EditionId is { } edition ? track.Appearances.FirstOrDefault(a => a.EditionId == edition) : null;
        return new PlayerEntry
        {
            TrackId = track.Id, EditionId = on?.EditionId, Title = track.Title, ArtistCredit = track.ArtistCredit, ArtistId = track.ArtistId,
            AlbumId = on?.AlbumId, AlbumTitle = on?.AlbumTitle, CoverUrl = track.CoverUrl, DurationSeconds = track.DurationSeconds,
        };
    }
}
