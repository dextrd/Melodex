@page "/settings/users"
@page "/settings/security"
@layout SettingsLayout
@inject MelodexClient Api
@inject AuthState Auth

<SectionTitle>Users · Melodex</SectionTitle>

@*
    Everyone who signs in, and what each may do. The admin, made at setup, may do everything and only they can change
    their account. Nobody can give a permission they don't have.
*@
@if (!Auth.May(UserPermissions.Users))
{
    <div class="empty card">
        You can't manage users. To change your own username or password, open <a href="account">your account</a>.
    </div>
}
else if (_users is null)
{
    <Loading />
}
else
{
    <section class="panel" aria-label="Users">
        <header class="panel-head">
            <div class="panel-title">
                <h2>Users</h2>
                <p class="muted small">
                    Everyone signs in, even at home. Give each person only what they need: someone who just listens needs Browse and Listen.
                    Their API keys can do no more than they may.
                </p>
            </div>
            <button class="primary small" @onclick="StartNew">Add user</button>
        </header>
        <div class="plugin-grid">
            @foreach (var user in _users)
            {
                var you = user.Id == Auth.Status?.UserId;
                var expanded = _expanded.Contains(user.Id);
                var permissions = user.IsAdmin ? "Everything"
                    : user.Permissions.Count == 0 ? "Can't do anything yet"
                    : string.Join(", ", UserPermissions.All.Where(p => user.Permissions.Contains(p.Id)).Select(p => p.Name));
                <div class="plugin-card user-card @(expanded ? "open" : "")">
                    <div class="plugin-top">
                        <strong class="ellipsis" title="@user.Username">@user.Username</strong>
                        @if (user.IsAdmin) { <span class="badge owned">Admin</span> }
                        @if (you) { <span class="badge neutral">You</span> }
                    </div>
                    @* Two lines, like plugins' descriptions; a click or tap shows the rest. *@
                    <div class="muted small plugin-about" title="@(expanded ? null : permissions)" role="button" tabindex="0"
                         aria-expanded="@(expanded ? "true" : "false")" @onclick="() => ToggleExpanded(user)"
                         @onkeydown="e => ToggleOnKey(e, user)">
                        @permissions
                    </div>
                    <div class="muted small">
                        @(user.LastSignInAt is { } signedIn ? $"Signed in {Format.Ago(signedIn)}" : "Never signed in")
                        @if (user.Keys > 0) { <span> · @Format.Count(user.Keys, "API key", "API keys")</span> }
                        @if (user.MediaServerUsername is { } server) { <span> · playlists synced with @user.MediaServer as @server</span> }
                    </div>
                    <div class="plugin-actions">
                        <span class="spacer"></span>
                        @if (!user.IsAdmin || Auth.Status?.IsAdmin == true)
                        {
                            <IconButton Icon="settings" Title="Edit" OnClick="() => StartEdit(user)" />
                        }
                        @if (!user.IsAdmin && !you)
                        {
                            <IconButton Icon="remove" Class="remove" Title="Remove" OnClick="() => _removing = user" />
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (_editing is { } editing)
{
    <Dialog Title="@(editing.User is null ? "Add user" : $"Edit {editing.User.Username}")" OnClose="() => _editing = null" Class="wide">
        <UserEditor User="editing.User" OnSaved="SavedAsync" OnCancel="() => _editing = null" />
    </Dialog>
}

@if (_removing is { } removing)
{
    <Dialog Title="@($"Remove {removing.Username}?")" OnClose="() => _removing = null" Alert="true">
        <p>
            They're signed out and can't sign in again@(removing.Keys > 0 ? $", and their {Format.Count(removing.Keys, "API key is", "API keys are")} revoked" : "").
            What they asked for stays.
        </p>
        @if (_error is not null) { <p class="error small">@_error</p> }
        <div class="toolbar dialog-buttons">
            <button @onclick="() => _removing = null">Cancel</button>
            <button class="danger" disabled="@_busy" @onclick="() => RemoveAsync(removing)">Remove</button>
        </div>
    </Dialog>
}

@code {
    private IReadOnlyList<UserInfo>? _users;
    // The user being edited, or none for a new one.
    private sealed record Editing(UserInfo? User);
    private Editing? _editing;
    private UserInfo? _removing;
    private bool _busy;
    private string? _error;
    private readonly HashSet<Guid> _expanded = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.May(UserPermissions.Users))
            return;
        _users = await Api.ListUsersAsync();
    }

    private void StartNew() => _editing = new Editing(null);

    private void StartEdit(UserInfo user) => _editing = new Editing(user);

    private void ToggleExpanded(UserInfo user)
    {
        if (!_expanded.Remove(user.Id))
            _expanded.Add(user.Id);
    }

    private void ToggleOnKey(KeyboardEventArgs e, UserInfo user)
    {
        if (e.Key is "Enter" or " ")
            ToggleExpanded(user);
    }

    private async Task SavedAsync()
    {
        _editing = null;
        _users = await Api.ListUsersAsync();
    }

    private async Task RemoveAsync(UserInfo user)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.RemoveUserAsync(user.Id);
            _removing = null;
            _users = await Api.ListUsersAsync();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
